{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usd-impact.com/schemas/monthly-report-public-safe-input-v1.json",
  "title": "USD Impact aggregate-safe Monthly Report source input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "periodStart",
    "periodEnd",
    "scorePath",
    "sourceWeeklyReports",
    "themeEvidence",
    "editorialRule",
    "rightsSafety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "monthly-report-public-safe-input-v1"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "periodStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "periodEnd": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scorePath": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "periodEnd",
          "value",
          "regime",
          "aggregateHistorySha256"
        ],
        "properties": {
          "periodEnd": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "value": {
            "type": "number"
          },
          "regime": {
            "type": "string",
            "minLength": 1
          },
          "aggregateHistorySha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "sourceWeeklyReports": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "periodEnd",
          "title",
          "contractSchemaVersion"
        ],
        "properties": {
          "periodEnd": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "contractSchemaVersion": {
            "const": "weekly-report-public-safe-v1"
          }
        }
      }
    },
    "themeEvidence": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "weeklyReportPeriodEnd",
          "title",
          "summary",
          "editionDates"
        ],
        "properties": {
          "weeklyReportPeriodEnd": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "editionDates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "editorialRule": {
      "type": "string",
      "minLength": 1
    },
    "rightsSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentValuesPublished",
        "componentZScoresPublished",
        "componentContributionsPublished",
        "providerProvenancePublished",
        "componentSourceUrlPublished"
      ],
      "properties": {
        "componentValuesPublished": {
          "const": false
        },
        "componentZScoresPublished": {
          "const": false
        },
        "componentContributionsPublished": {
          "const": false
        },
        "providerProvenancePublished": {
          "const": false
        },
        "componentSourceUrlPublished": {
          "const": false
        }
      }
    }
  }
}
