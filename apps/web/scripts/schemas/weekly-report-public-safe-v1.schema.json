{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usd-impact.com/schemas/weekly-report-public-safe-v1.json",
  "title": "USD Impact aggregate-safe Weekly Report candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "periodStart",
    "periodEnd",
    "generatedAt",
    "title",
    "summary",
    "score",
    "themes",
    "sourceEditions",
    "catalysts",
    "complianceNote",
    "methodologyNote",
    "rightsSafety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "weekly-report-public-safe-v1"
    },
    "periodStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "periodEnd": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "regime",
        "weekOverWeekChange",
        "fourWeekChange",
        "aggregateHistorySha256"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "regime": {
          "type": "string",
          "minLength": 1
        },
        "weekOverWeekChange": {
          "type": "number"
        },
        "fourWeekChange": {
          "type": "number"
        },
        "aggregateHistorySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "editionDates"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "editionDates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "sourceEditions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "title",
          "url"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^/news/\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "catalysts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "event",
          "sourceEditionDate"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "sourceEditionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "complianceNote": {
      "type": "string",
      "minLength": 1
    },
    "methodologyNote": {
      "type": "string",
      "minLength": 1
    },
    "rightsSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoreSchemaVersion",
        "componentValuesPublished",
        "componentZScoresPublished",
        "componentContributionsPublished",
        "providerProvenancePublished",
        "componentSourceUrlPublished"
      ],
      "properties": {
        "scoreSchemaVersion": {
          "const": "score-public-v2-safe-1"
        },
        "componentValuesPublished": {
          "const": false
        },
        "componentZScoresPublished": {
          "const": false
        },
        "componentContributionsPublished": {
          "const": false
        },
        "providerProvenancePublished": {
          "const": false
        },
        "componentSourceUrlPublished": {
          "const": false
        }
      }
    }
  }
}
