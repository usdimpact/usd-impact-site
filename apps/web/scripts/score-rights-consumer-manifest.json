{
  "version": 2,
  "state": "hold",
  "effective_date": "2026-10-28",
  "pipeline_issue": "https://github.com/usdimpact/usd-impact-pipeline/issues/155",
  "production_change_authorized": false,
  "classes": {
    "B": {
      "label": "methodology_or_source_contract"
    },
    "C": {
      "label": "direct_component_derived_release_evidence"
    },
    "D": {
      "label": "aggregate_research_with_provider_provenance"
    },
    "E": {
      "label": "component_derived_diagnostic_research"
    },
    "F": {
      "label": "component_revision_research"
    },
    "P": {
      "label": "protected_score_navigation"
    },
    "R": {
      "label": "reference_to_class_c_artifact_without_component_values"
    }
  },
  "path_classes": {
    "/data/score_v2_data_semantics.json": "B",
    "/data/score_v2_methodology.json": "B",
    "/data/score_v2_methodology.schema.json": "B",
    "/data/research/independent_replication_protocol.json": "B",
    "/data/weekly_input_latest.json": "C",
    "/data/usd_impact_score_v2.json": "C",
    "/data/usd_impact_score_v2.csv": "C",
    "/data/research/score_v2_point_in_time_latest.json": "D",
    "/data/research/score_v2_robustness_latest.json": "E",
    "/data/research/score_v2_vintage_comparison_latest.json": "F",
    "/data/research/score_v2_vintage_comparison_latest.csv": "F",
    "/data/research/score_v2_vintage_comparison_latest.html": "F",
    "/archive/en/": "P",
    "/en/": "P"
  },
  "page_link_consumers": {
    "src/pages/about.astro": {
      "direct_score_paths": [
        "/data/research/score_v2_vintage_comparison_latest.json",
        "/data/research/score_v2_vintage_comparison_latest.csv",
        "/data/score_v2_data_semantics.json"
      ],
      "dynamic_score_paths": []
    },
    "src/pages/score/methodology.astro": {
      "direct_score_paths": [
        "/data/research/score_v2_vintage_comparison_latest.json",
        "/data/score_v2_methodology.json",
        "/data/score_v2_methodology.schema.json",
        "/data/score_v2_data_semantics.json",
        "/data/weekly_input_latest.json",
        "/data/usd_impact_score_v2.json",
        "/data/usd_impact_score_v2.csv",
        "/data/research/score_v2_robustness_latest.json",
        "/data/research/score_v2_point_in_time_latest.json",
        "/data/research/score_v2_vintage_comparison_latest.csv",
        "/archive/en/"
      ],
      "dynamic_score_paths": []
    },
    "src/pages/research/independent-replication.astro": {
      "direct_score_paths": [
        "/data/research/independent_replication_protocol.json"
      ],
      "dynamic_score_paths": []
    },
    "src/pages/score.astro": {
      "direct_score_paths": [],
      "dynamic_score_paths": [
        "/data/research/score_v2_vintage_comparison_latest.html"
      ]
    },
    "src/pages/index.astro": {
      "direct_score_paths": [],
      "dynamic_score_paths": [
        "/en/"
      ]
    }
  },
  "runtime_consumers": {
    ".github/workflows/weekly-report.yml": {
      "class": "C",
      "role": "scheduled_fetch",
      "contracts": [
        "https://score.usd-impact.com/archive/$WEEK/weekly_input.json"
      ],
      "new_publication_held": true
    },
    "apps/web/scripts/generate-weekly-report.mjs": {
      "class": "C",
      "role": "report_generator",
      "publishes_named_component_contributions": true,
      "publishes_class_c_source_url": true
    },
    "apps/web/src/content/weekly-reports/*.md": {
      "class": "C",
      "role": "published_historical_content",
      "accepted_source_origins": [
        "https://score.usd-impact.com",
        "https://usd-impact-pipeline.pages.dev"
      ],
      "may_contain_named_component_contributions": true
    },
    "apps/web/src/content/monthly-reports/*.md": {
      "class": "C",
      "role": "downstream_published_synthesis",
      "may_republish_named_component_contributions": true,
      "automatic_generation": false
    },
    "apps/web/src/pages/score/methodology.astro": {
      "class": "E",
      "role": "embedded_diagnostic_copy",
      "embeds_component_derived_diagnostic_values": true
    },
    "apps/web/src/lib/weekly-newsletter-contract.js": {
      "class": "R",
      "role": "indirect_reference",
      "republishes_component_values": false,
      "carries_score_source_url": true
    },
    "apps/web/src/pages/newsletter/weekly/[date].json.ts": {
      "class": "R",
      "role": "public_static_newsletter_artifact",
      "derives_from_weekly_report": true
    }
  },
  "weekly_report_publication_hold_required": true,
  "manual_monthly_publication_requires_rights_review": true,
  "historical_content_treatment_unresolved": true
}
