  "runtime_consumers": {
    ".github/workflows/weekly-report.yml": {
      "class": "C",
      "role": "scheduled_fetch",
      "contract": "https://score.usd-impact.com/archive/$WEEK/weekly_input.json",
      "publishes_new_output": true
    },
    "apps/web/scripts/generate-weekly-report.mjs": {
      "class": "C",
      "role": "report_generator",
      "contract": "https://score.usd-impact.com/archive/${week}/weekly_input.json",
      "publishes_named_component_contributions": true,
      "publishes_source_provenance_reference": true
    },
    "apps/web/src/content/weekly-reports/*.md": {
      "class": "C",
      "role": "published_historical_content",
      "contracts": [
        "https://usd-impact-pipeline.pages.dev/archive/<periodEnd>/weekly_input.json",
        "https://score.usd-impact.com/archive/<periodEnd>/weekly_input.json"
      ],
      "classification_basis": "Published Score values/regime and component-derived weekly analysis; the archive host changed historically without changing the rights-sensitive consumer class.",
