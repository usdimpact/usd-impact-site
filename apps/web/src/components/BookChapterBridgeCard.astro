---
const {
  chapter,
  rationale,
  href = `/book/read-the-dollar-first/companion/chapter/${chapter.code}/`,
  linkLabel = 'Open the chapter companion',
} = Astro.props;
---
<article class="book-chapter-bridge card">
  <div class="eyebrow">Book connection</div>
  <h2>Chapter {chapter.number}: {chapter.title}</h2>
  <p>{rationale}</p>
  <a class="button primary" href={href}>{linkLabel}</a>
</article>

<style>
  .book-chapter-bridge { margin-top: 40px; border-left: 5px solid var(--gold); }
  .book-chapter-bridge h2 { margin: 6px 0 8px; font-size: clamp(24px, 3vw, 34px); }
  .book-chapter-bridge p { max-width: 760px; margin: 0 0 20px; color: var(--slate); }
</style>
