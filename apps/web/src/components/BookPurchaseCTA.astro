---
const checklistDownload = '/downloads/USD_Impact_Weekly_Dollar_Regime_Checklist_Lead_Magnet.pdf';
const {
  secondary = 'Download the weekly checklist',
  secondaryHref = checklistDownload,
  secondaryDownload = true,
} = Astro.props;
---
<section class="book-offer" aria-label="Read the Dollar First public sample and previous purchases">
  <div class="book-offer-summary">
    <p class="book-offer-label">Explore a public lesson</p>
    <ul class="book-offer-inclusions">
      <li>One public lesson from Read the Dollar First</li>
      <li>Public learning checkpoints and source-backed practice</li>
      <li>Complete 51-film syllabus overview, not protected film playback</li>
    </ul>
  </div>

  <div class="book-offer-action">
    <p class="book-offer-standard">
      The free sample does not include protected full-book chapters, audiobook playback or member-only film playback.
      Additional access depends on the rights and terms for each item.
    </p>
    <div id="book-purchase-cta" class="button-row">
      <a
        id="book-primary-cta"
        class="button primary"
        href="/book/read-the-dollar-first/preview/"
      >Read the public book sample</a>
      {secondaryDownload ? (
        <a class="button secondary" href={secondaryHref} download>{secondary}</a>
      ) : (
        <a class="button secondary" href={secondaryHref}>{secondary}</a>
      )}
    </div>
    <p class="book-existing-access">
      Already purchased a Library Pass?
      <a href="/account/sign-in/?next=/account/">Sign in with the account used for your purchase</a>
      to access the materials included in your order.
    </p>
  </div>
</section>

<style>
  :global(#book-waitlist[hidden]) {
    display: none;
  }
</style>
