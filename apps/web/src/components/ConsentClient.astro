    gap: 24px;
    align-items: center;
    max-width: 1120px;
    margin: 0 auto;
    padding: 20px 22px;
    color: #f3f5f7;
    background: #071525;
    border: 1px solid #30455b;
    border-radius: 16px;
    box-shadow: 0 18px 60px rgba(2, 10, 20, .35);
  }

  .privacy-consent-banner[hidden] { display: none; }
  .privacy-consent-banner strong { color: #d7b45a; font-size: 18px; }
  .privacy-consent-banner p { max-width: 760px; margin: 7px 0 0; color: #dce2e9; font-size: 14px; }
  .privacy-consent-banner a { color: #fff; }
  .privacy-consent-actions { display: flex; gap: 9px; flex-wrap: wrap; justify-content: flex-end; }

  .privacy-consent-button {
    min-height: 42px;
    padding: 10px 15px;
    border: 1px solid transparent;
    border-radius: 10px;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .privacy-consent-primary { color: #071525; background: #d7b45a; }
  .privacy-consent-secondary { color: #f3f5f7; background: transparent; border-color: #8d9bab; }
  .privacy-consent-button:focus-visible, .privacy-consent-close:focus-visible { outline: 3px solid #f3cc68; outline-offset: 3px; }

  .privacy-consent-dialog {
    width: min(680px, calc(100vw - 32px));
    padding: 0;
    color: #0b1f33;
    background: #fff;
    border: 1px solid #cfd6df;
    border-radius: 18px;
    box-shadow: 0 24px 80px rgba(2, 10, 20, .35);
  }

  .privacy-consent-dialog::backdrop { background: rgba(2, 10, 20, .7); }
  .privacy-consent-dialog-copy, .privacy-consent-category, .privacy-consent-dialog-actions { padding: 20px 24px; }
  .privacy-consent-dialog-copy { display: flex; justify-content: space-between; gap: 20px; border-bottom: 1px solid #e1e5ea; }
  .privacy-consent-dialog h2 { margin: 4px 0 8px; }
  .privacy-consent-dialog h3 { margin: 0 0 6px; font-size: 18px; }
  .privacy-consent-dialog p { margin: 0; color: #46586b; }
  .privacy-consent-eyebrow { color: #8a6411 !important; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .privacy-consent-close { align-self: start; padding: 0 8px; color: #0b1f33; background: transparent; border: 0; font-size: 30px; cursor: pointer; }
  .privacy-consent-category { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 20px; align-items: center; border-bottom: 1px solid #e1e5ea; }
  .privacy-consent-category > strong { color: #24613d; font-size: 13px; }
  .privacy-consent-category input { width: 24px; height: 24px; accent-color: #0b1f33; }
  .privacy-consent-dialog-actions { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .privacy-consent-dialog-actions a { color: #0b1f33; font-weight: 700; }

  :global(.footer-privacy-settings) {
    padding: 0;
    color: #dce2e9;
    background: transparent;
    border: 0;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  :global(.footer-privacy-settings:focus-visible) { outline: 3px solid #f3cc68; outline-offset: 3px; }

  @media (max-width: 820px) {
    .privacy-consent-banner { grid-template-columns: 1fr; }
    .privacy-consent-actions { justify-content: flex-start; }
  }

  @media (max-width: 520px) {
    .privacy-consent-banner { right: 10px; bottom: 10px; left: 10px; padding: 18px; }
    .privacy-consent-actions { display: grid; }
    .privacy-consent-button { width: 100%; }
    .privacy-consent-dialog-copy, .privacy-consent-category, .privacy-consent-dialog-actions { padding: 18px; }
    .privacy-consent-dialog-actions { align-items: stretch; flex-direction: column; }
  }
</style>
