---
const rawMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim() ?? '';
const measurementIdPattern = /^G-[A-Z0-9]{4,32}$/;
if (rawMeasurementId && !measurementIdPattern.test(rawMeasurementId)) {
  throw new Error('PUBLIC_GA4_MEASUREMENT_ID must be a GA4 Measurement ID such as G-XXXXXXXXXX.');
}
const measurementId = measurementIdPattern.test(rawMeasurementId) ? rawMeasurementId : '';
---

{measurementId && (
  <span id="usd-impact-ga4-config" hidden data-measurement-id={measurementId}></span>
)}

<script>
  // @ts-nocheck
  (() => {
    // Keep configuration inert; let Astro process and authorize the client script.
    const measurementId = document.getElementById('usd-impact-ga4-config')?.getAttribute('data-measurement-id') ?? '';
    if (!/^G-[A-Z0-9]{4,32}$/.test(measurementId) || measurementId.trim() !== measurementId) return;

    const CONSENT_CHANGE_EVENT = 'usd-impact:consent-change';
    const CONSENT_READY_EVENT = 'usd-impact:consent-ready';
    const ANALYTICS_EVENT = 'usd-impact:analytics-event';
    const SCRIPT_ID = 'usd-impact-ga4-script';
    const DISABLE_KEY = `ga-disable-${measurementId}`;
    const COOKIE_MAX_AGE_SECONDS = 60 * 60 * 24 * 365;
    const ALLOWED_EVENTS = new Set([
      'checklist_download',
      'checkout_view',
      'checkout_button_click',
      'checkout_sign_in_redirect',
      'quiz_start',
      'quiz_retry',
      'quiz_complete',
      'waitlist_submission_success',
      'daily_learning_subscribe_success',
      'library_section_view',
    ]);
    const QUIZ_ID_PATTERN = /^[a-zA-Z0-9._~-]{1,128}$/;
    const LIBRARY_FORMATS = new Set(['guided', 'audiobook', 'video']);
    let configured = false;

    const analyticsAllowed = () => window.USDImpactConsent?.analyticsAllowed?.() === true;

    const expireCookie = (name) => {
      const hostname = window.location.hostname;
      const domains = ['', hostname, `.${hostname}`, '.usd-impact.com'];
      for (const domain of domains) {
        const domainPart = domain ? `; Domain=${domain}` : '';
        document.cookie = `${name}=; Path=/; Max-Age=0; SameSite=Lax${domainPart}`;
      }
    };

    const clearGaCookies = () => {
      document.cookie
        .split(';')
        .map((part) => part.trim().split('=')[0])
        .filter((name) => name === '_ga' || name.startsWith('_ga_'))
        .forEach(expireCookie);
    };

    const ensureGtag = () => {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };
      return window.gtag;
    };

    const loadGa4 = () => {
      if (!analyticsAllowed()) return;
      window[DISABLE_KEY] = false;
      const gtag = ensureGtag();
      gtag('consent', 'default', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });

      if (!document.getElementById(SCRIPT_ID)) {
        const script = document.createElement('script');
        script.id = SCRIPT_ID;
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
        document.head.appendChild(script);
      }

      if (!configured) {
        gtag('js', new Date());
        gtag('config', measurementId, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
          anonymize_ip: true,
          cookie_expires: COOKIE_MAX_AGE_SECONDS,
          send_page_view: true,
        });
        configured = true;
      } else {
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }
    };

    const disableGa4 = () => {
      window[DISABLE_KEY] = true;
      clearGaCookies();
    };

    const applyConsent = () => {
      if (analyticsAllowed()) loadGa4();
      else disableGa4();
    };

    const cleanQuizId = (value) => (
      typeof value === 'string' && QUIZ_ID_PATTERN.test(value) ? value : undefined
    );

    const cleanInteger = (value, min, max) => (
      Number.isInteger(value) && value >= min && value <= max ? value : undefined
    );

    const sendAnalyticsEvent = (event) => {
      if (!analyticsAllowed() || !(event instanceof CustomEvent)) return;
      const eventName = event.detail?.eventName;
      const details = event.detail?.details;
      if (typeof eventName !== 'string' || !ALLOWED_EVENTS.has(eventName)) return;

      loadGa4();
      const params = {};
      if (eventName.startsWith('quiz_')) {
        const quizId = cleanQuizId(details?.quizId);
        if (!quizId) return;
        params.quiz_id = quizId;
      }
      if (eventName === 'library_section_view') {
        if (!LIBRARY_FORMATS.has(details?.format)) return;
        params.format = details.format;
      }
      if (eventName === 'quiz_complete') {
        if (details?.outcome !== 'pass' && details?.outcome !== 'fail') return;
        const score = cleanInteger(details?.score, 0, 1000);
        const questionCount = cleanInteger(details?.questionCount, 1, 1000);
        if (score === undefined || questionCount === undefined || score > questionCount) return;
        params.outcome = details.outcome;
        params.score = score;
        params.question_count = questionCount;
      }

      ensureGtag()('event', eventName, params);
    };

    window.addEventListener(CONSENT_READY_EVENT, applyConsent);
    window.addEventListener(CONSENT_CHANGE_EVENT, applyConsent);
    window.addEventListener(ANALYTICS_EVENT, sendAnalyticsEvent);
    applyConsent();
  })();
</script>
