---
const checklistDownload = '/downloads/USD_Impact_Weekly_Dollar_Regime_Checklist_Lead_Magnet.pdf';
const neutralCheckoutUrl = '/checkout/';
---
<div
  class="button-row"
  data-home-library-pass-cta
  data-home-checkout-readiness="checking"
  aria-busy="true"
>
  <a
    class="button primary"
    data-home-library-pass-primary
    href={neutralCheckoutUrl}
  >Check Library Pass availability</a>
  <a class="button secondary" href={checklistDownload} download>Download the weekly checklist</a>
</div>
<p
  class="visually-hidden"
  data-home-library-pass-status
  role="status"
  aria-live="polite"
>Checking current Library Pass checkout availability…</p>

<script>
  import { bookPurchasePresentation } from '../lib/checkout-client.js';

  const container = document.querySelector('[data-home-library-pass-cta]');
  const primary = document.querySelector('[data-home-library-pass-primary]');
  const status = document.querySelector('[data-home-library-pass-status]');
  const waitlistUrl = '/book/read-the-dollar-first/#book-waitlist';

  const renderPresentation = (presentation) => {
    if (!(primary instanceof HTMLAnchorElement)) return;

    primary.textContent = presentation.primaryLabel;
    primary.href = presentation.available ? presentation.primaryHref : waitlistUrl;
    if (status) status.textContent = presentation.message;
    if (container instanceof HTMLElement) {
      container.dataset.homeCheckoutReadiness = presentation.verificationState;
      container.setAttribute('aria-busy', 'false');
    }
  };

  fetch('/api/commerce-readiness', {
    method: 'GET',
    credentials: 'same-origin',
    cache: 'no-store',
    headers: { Accept: 'application/json' },
  })
    .then(async (response) => {
      const body = await response.json().catch(() => ({}));
      if (!response.ok || !body.commerce) throw new Error('Commerce readiness could not be verified.');
      renderPresentation(bookPurchasePresentation(body.commerce));
    })
    .catch(() => {
      renderPresentation(bookPurchasePresentation(null));
      if (container instanceof HTMLElement) {
        container.dataset.homeCheckoutReadiness = 'error';
      }
      if (status) {
        status.textContent = 'Checkout availability could not be verified. The book waitlist remains available.';
      }
    });
</script>
