<script>
  (() => {
    if (!('serviceWorker' in navigator)) return;
    if (window.location.pathname.replace(/\/+$/, '') === '/account/notifications') return;

    window.addEventListener('load', async () => {
      try {
        const registration = await navigator.serviceWorker.getRegistration('/');
        if (!registration) return;
        if (!registration.pushManager) {
          await registration.unregister();
          return;
        }

        let subscription;
        try {
          subscription = await registration.pushManager.getSubscription();
        } catch (error) {
          console.warn('USD Impact service-worker subscription check failed; preserving registration.', error);
          return;
        }

        if (!subscription) await registration.unregister();
      } catch (error) {
        console.warn('USD Impact legacy service-worker cleanup failed.', error);
      }
    }, { once: true });
  })();
</script>
