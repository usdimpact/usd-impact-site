<script>
  // @ts-nocheck
  const TELEMETRY_ENDPOINT = '/api/telemetry';
  const CHECKLIST_PATH = '/downloads/USD_Impact_Weekly_Dollar_Regime_Checklist_Lead_Magnet.pdf';
  const CHECKOUT_PATH = '/checkout/';
  const CHECKOUT_SIGN_IN_EVENT = 'usd-impact:checkout-sign-in-redirect';
  const CONSENT_CHANGE_EVENT = 'usd-impact:consent-change';
  const CONSENT_READY_EVENT = 'usd-impact:consent-ready';
  const observedResults = new WeakSet();

  const analyticsAllowed = () => window.USDImpactConsent?.analyticsAllowed?.() === true;

  const readCampaign = () => {
    const query = new URLSearchParams(window.location.search);
    const clean = (key) => {
      const value = query.get(key);
      return value && /^[a-zA-Z0-9._~-]{1,64}$/.test(value) ? value : undefined;
    };
    return {
      utmSource: clean('utm_source'),
      utmMedium: clean('utm_medium'),
      utmCampaign: clean('utm_campaign'),
    };
  };

  const createEventId = () => {
    if (typeof crypto?.randomUUID === 'function') return crypto.randomUUID();
    return `evt-${Date.now()}-${Math.random().toString(36).slice(2, 14)}`;
  };

  const track = (eventName, details = {}) => {
    if (!analyticsAllowed()) return false;

    const payload = {
      eventId: createEventId(),
      eventName,
      route: window.location.pathname,
      ...readCampaign(),
      ...details,
    };

    fetch(TELEMETRY_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      keepalive: true,
    }).catch(() => {
      // Telemetry must never interrupt downloads, quiz scoring, or navigation.
    });
    return true;
  };

  let checkoutViewTracked = false;
  const trackCheckoutView = () => {
    if (window.location.pathname !== CHECKOUT_PATH || checkoutViewTracked) return;
    checkoutViewTracked = track('checkout_view');
  };

  window.addEventListener(CONSENT_READY_EVENT, trackCheckoutView);
  window.addEventListener(CONSENT_CHANGE_EVENT, (event) => {
    if (event instanceof CustomEvent && event.detail?.analytics === true) trackCheckoutView();
  });
  trackCheckoutView();

  window.addEventListener(CHECKOUT_SIGN_IN_EVENT, () => {
    if (window.location.pathname === CHECKOUT_PATH) track('checkout_sign_in_redirect');
  });

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('a, button') : null;
    if (!(target instanceof HTMLElement)) return;

    if (
      window.location.pathname === CHECKOUT_PATH
      && target instanceof HTMLButtonElement
      && target.id === 'checkout-button'
      && !target.hidden
    ) {
      track('checkout_button_click');
    }

    if (target instanceof HTMLAnchorElement) {
      const url = new URL(target.href, window.location.origin);
      if (url.origin === window.location.origin && url.pathname === CHECKLIST_PATH) {
        track('checklist_download');
      }
    }

    const quizRoot = target.closest('[data-quiz-root]');
    if (!(quizRoot instanceof HTMLElement)) return;
    const quizId = quizRoot.dataset.canonicalId;
    if (!quizId) return;

    if (target.matches('[data-quiz-start]')) {
      track('quiz_start', { quizId });
    } else if (target.matches('[data-quiz-retake]')) {
      track('quiz_retry', { quizId });
    }
  });

  const observeQuizResult = (root) => {
    if (!(root instanceof HTMLElement) || observedResults.has(root)) return;
    const summary = root.querySelector('[data-quiz-result-summary]');
    if (!(summary instanceof HTMLElement)) return;

    observedResults.add(root);
    let lastResult = '';

    const observer = new MutationObserver(() => {
      const heading = summary.querySelector('h2')?.textContent?.trim() ?? '';
      if (!heading || heading === lastResult) return;

      const match = heading.match(/^(Passed|Completed|Review and retry) — (\d+)\/(\d+)$/);
      if (!match) return;

      lastResult = heading;
      const quizId = root.dataset.canonicalId;
      if (!quizId) return;

      track('quiz_complete', {
        quizId,
        outcome: match[1] === 'Review and retry' ? 'fail' : 'pass',
        score: Number(match[2]),
        questionCount: Number(match[3]),
      });
    });

    observer.observe(summary, { childList: true, subtree: true, characterData: true });
  };

  document.querySelectorAll('[data-quiz-root]').forEach(observeQuizResult);
</script>
