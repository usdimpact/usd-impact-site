---
import '../styles/global.css';
import '../styles/account.css';
import BookChapterBridgeCard from '../components/BookChapterBridgeCard.astro';
import ConsentClient from '../components/ConsentClient.astro';
import TelemetryClient from '../components/TelemetryClient.astro';
import PwaClient from '../components/PwaClient.astro';
import { getChapterById, getSurfaceBridgeForPath } from '../data/book-site-bridge/index.mjs';
const { title, description, noindex = false, stylesheets = [] } = Astro.props;
const surfaceBridge = getSurfaceBridgeForPath(Astro.url.pathname);
const surfaceChapter = surfaceBridge ? getChapterById(surfaceBridge.chapterId) : null;
const currentPath = Astro.url.pathname;
const pageIsActive = (href) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
const learnIsActive = [
  "/start-here/",
  "/framework/dollar-transmission-chain/",
  "/lead-magnets/weekly-dollar-regime-checklist/",
].some(pageIsActive);
const updatesAreActive = ["/news/", "/score/", "/reports/"].some(pageIsActive);
const libraryIsActive = ["/book/", "/audiobook/", "/video-library/"].some(pageIsActive);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1f33" />
    <meta name="application-name" content="USD Impact" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="USD Impact" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/assets/logo/USDImpact_Icon_Color_2048.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label="USD Impact home">
          <img
            src="/assets/logo/USDImpact_Horizontal_Color_NoTagline_2048.png"
            alt="USD Impact"
            width="2048"
            height="614"
            decoding="async"
          />
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-navigation"
        >
          <span class="nav-toggle-icon" aria-hidden="true"></span>
          <span>Menu</span>
        </button>
        <nav id="site-navigation" class="nav" aria-label="Main navigation" data-open="false">
          <details class="nav-group" data-nav-group>
            <summary class:list={["nav-summary", { "is-active": learnIsActive }]}>Learn</summary>
            <div class="nav-submenu">
              <a href="/start-here/" aria-current={pageIsActive("/start-here/") ? "page" : undefined}>Start Here</a>
              <a href="/framework/dollar-transmission-chain/" aria-current={pageIsActive("/framework/dollar-transmission-chain/") ? "page" : undefined}>Framework</a>
              <a href="/lead-magnets/weekly-dollar-regime-checklist/" aria-current={pageIsActive("/lead-magnets/weekly-dollar-regime-checklist/") ? "page" : undefined}>Weekly Checklist</a>
            </div>
          </details>
          <details class="nav-group" data-nav-group>
            <summary class:list={["nav-summary", { "is-active": updatesAreActive }]}>Updates</summary>
            <div class="nav-submenu">
              <a href="/news/" aria-current={pageIsActive("/news/") ? "page" : undefined}>Daily USD Impact</a>
              <a href="/score/" aria-current={pageIsActive("/score/") ? "page" : undefined}>Weekly Score</a>
              <a href="/reports/" aria-current={pageIsActive("/reports/") ? "page" : undefined}>Reports</a>
            </div>
          </details>
          <details class="nav-group" data-nav-group>
            <summary class:list={["nav-summary", { "is-active": libraryIsActive }]}>Library</summary>
            <div class="nav-submenu">
              <a href="/book/read-the-dollar-first/" aria-current={pageIsActive("/book/") ? "page" : undefined}>Book</a>
              <a href="/audiobook/read-the-dollar-first/" aria-current={pageIsActive("/audiobook/") ? "page" : undefined}>Audiobook</a>
              <a href="/video-library/" aria-current={pageIsActive("/video-library/") ? "page" : undefined}>Video Library</a>
            </div>
          </details>
          <a class="nav-direct" href="/account/" aria-current={pageIsActive("/account/") ? "page" : undefined}>Account</a>
        </nav>
      </div>
    </header>
    <slot />
    {surfaceBridge && surfaceChapter && (
      <aside
        class="container contextual-book-bridge"
        aria-label="Book connection"
        data-surface-bridge-id={surfaceBridge.id}
      >
        <BookChapterBridgeCard
          chapter={surfaceChapter}
          rationale={surfaceBridge.rationale}
          linkLabel={surfaceBridge.linkLabel}
        />
      </aside>
    )}
    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img
            src="/assets/logo/USDImpact_Horizontal_Color_NoTagline_2048.png"
            alt="USD Impact"
            width="2048"
            height="614"
            loading="lazy"
            decoding="async"
          />
          <p>Practical education for reading the dollar first.</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <div class="footer-group">
            <p class="footer-heading">Product</p>
            <a href="/account/">Account</a>
            <a href="/book/read-the-dollar-first/">Book &amp; pricing</a>
            <a href="/audiobook/read-the-dollar-first/">Audiobook</a>
            <a href="/video-library/">Video Library</a>
          </div>
          <div class="footer-group">
            <p class="footer-heading">Learn</p>
            <a href="/start-here/">Start Here</a>
            <a href="/framework/dollar-transmission-chain/">Framework</a>
            <a href="/lead-magnets/weekly-dollar-regime-checklist/">Weekly Checklist</a>
          </div>
          <div class="footer-group">
            <p class="footer-heading">Research</p>
            <a href="/news/">Daily USD Impact</a>
            <a href="/score/">Weekly Score</a>
            <a href="/reports/">Reports</a>
            <a href="/research/evidence-map/">Evidence Map</a>
            <a href="/research/independent-replication/">Replication</a>
          </div>
          <div class="footer-group">
            <p class="footer-heading">Company</p>
            <a href="/about/">About &amp; transparency</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/refund-policy/">Refund Policy</a>
            <a href="/compliance/">Compliance</a>
            <button id="privacy-settings-button" class="footer-privacy-settings" type="button">Privacy settings</button>
          </div>
        </nav>
        <div class="footer-meta">
          <span>Operated by KELA LEADS S.R.L.</span>
          <span>CUI 40790448 · Trade Register J38/820/2020 · EUID ROONRC.J38/820/2020</span>
          <span>Educational content only — not investment, legal, tax, trading, or financial advice.</span>
        </div>
      </div>
    </footer>
    <script>
      const navigation = document.querySelector("#site-navigation");
      const navigationToggle = document.querySelector(".nav-toggle");
      const navigationGroups = Array.from(document.querySelectorAll("[data-nav-group]"));

      const closeNavigationGroups = (except: Element | null = null) => {
        navigationGroups.forEach((group) => {
          if (group !== except) group.removeAttribute("open");
        });
      };

      const setNavigationOpen = (open) => {
        if (!(navigation instanceof HTMLElement) || !(navigationToggle instanceof HTMLButtonElement)) return;
        navigation.dataset.open = String(open);
        navigationToggle.setAttribute("aria-expanded", String(open));
        if (!open) closeNavigationGroups();
      };

      navigationToggle?.addEventListener("click", () => {
        const open = navigation instanceof HTMLElement && navigation.dataset.open === "true";
        setNavigationOpen(!open);
      });

      navigationGroups.forEach((group) => {
        group.addEventListener("toggle", () => {
          if (group.hasAttribute("open")) closeNavigationGroups(group);
        });
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (!navigation?.contains(target) && !navigationToggle?.contains(target)) closeNavigationGroups();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        closeNavigationGroups();
        setNavigationOpen(false);
        if (navigationToggle instanceof HTMLButtonElement) navigationToggle.focus();
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setNavigationOpen(false));
      });

      const firstMain = document.querySelector("main");
      if (firstMain && !firstMain.id) firstMain.id = "main-content";
    </script>
    <ConsentClient />
    <TelemetryClient />
    <PwaClient />
  </body>
</html>
