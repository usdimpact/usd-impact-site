---
import '../styles/global.css';
import '../styles/account.css';
import TelemetryClient from '../components/TelemetryClient.astro';
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/">
          <img
            src="/assets/logo/USDImpact_Horizontal_Color_NoTagline_2048.png"
            alt=""
            width="2048"
            height="614"
            decoding="async"
          />
          <span>USD Impact</span>
        </a>
        <nav class="nav" aria-label="Main navigation">
          <a href="/start-here/">Start Here</a>
          <a href="/news/">Daily USD Impact</a>
          <a href="/score/">Weekly Score</a>
          <a href="/reports/">Reports</a>
          <a href="/book/read-the-dollar-first/">Book</a>
          <a href="/framework/dollar-transmission-chain/">Framework</a>
          <a href="/lead-magnets/weekly-dollar-regime-checklist/">Checklist</a>
          <a href="/account/">Account</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="container">
        <strong>USD Impact</strong><br />
        Educational macro-finance framework. Not investment, legal, tax, trading, or financial advice.
        <div class="footer-links">
          <a href="/news/">Daily USD Impact</a>
          <a href="/score/">Weekly USD Impact Score</a>
          <a href="/reports/">Reports</a>
          <a href="/account/">Account</a>
          <a href="/privacy/">Privacy notice</a>
          <a href="/compliance/">Compliance</a>
        </div>
      </div>
    </footer>
    <TelemetryClient />
  </body>
</html>
