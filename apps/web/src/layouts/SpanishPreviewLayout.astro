---
import '../styles/global.css';
import { canonicalUrlForRequest } from '../lib/canonical-url.js';

const {
  title,
  description,
  currentPath = '/es',
  englishPath = '/',
} = Astro.props;

const links = [
  { label: 'Inicio', href: '/es/' },
  { label: 'Empieza aquí', href: '/es/start-here/' },
  { label: 'Marco del dólar', href: '/es/dollar-framework/' },
  { label: 'Cadena de transmisión', href: '/es/framework/dollar-transmission-chain/' },
  { label: 'Panel de tres diales', href: '/es/framework/three-dial-dashboard/' },
];

const normalize = (value) => String(value || '/').replace(/\/+$/, '') || '/';
const activePath = normalize(currentPath);
const isActive = (href) => activePath === normalize(href);
const canonicalUrl = canonicalUrlForRequest(Astro.url);
const englishUrl = canonicalUrlForRequest(new URL(englishPath, Astro.url));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1f33" />
    <meta name="application-name" content="USD Impact" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="icon" href="/assets/logo/USDImpact_Icon_Color_192.png" type="image/png" sizes="192x192" />
    <style is:global>
      .page-content table { width: 100%; border-collapse: collapse; }
      .page-content th, .page-content td {
        padding: 0.75rem;
        border-bottom: 1px solid #dbe1e8;
        text-align: left;
        vertical-align: top;
      }
      .page-content th { color: var(--navy); font-weight: 800; }
      @media (max-width: 760px) {
        .page-content table {
          display: block;
          max-width: 100%;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }
        .page-content th, .page-content td { min-width: 9rem; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/es/" aria-label="Inicio de USD Impact en español">
          <img src="/assets/logo/USDImpact_Horizontal_Color_NoTagline_256.png"
            srcset="/assets/logo/USDImpact_Horizontal_Color_NoTagline_256.png 256w, /assets/logo/USDImpact_Horizontal_Color_NoTagline_512.png 512w"
            sizes="148px" alt="USD Impact" width="256" height="77" decoding="async" />
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
          <span class="nav-toggle-icon" aria-hidden="true"></span><span>Menú</span>
        </button>
        <nav id="site-navigation" class="nav" aria-label="Navegación principal en español" data-open="false">
          {links.map((link) => (
            <a class="nav-direct" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
          ))}
          <a class="nav-direct" href={englishPath} hreflang="en" lang="en">English</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img src="/assets/logo/USDImpact_Horizontal_Color_NoTagline_256.png"
            srcset="/assets/logo/USDImpact_Horizontal_Color_NoTagline_256.png 256w, /assets/logo/USDImpact_Horizontal_Color_NoTagline_512.png 512w"
            sizes="164px" alt="USD Impact" width="256" height="77" loading="lazy" decoding="async" />
          <p>Educación práctica para leer primero el dólar.</p>
        </div>
        <nav class="footer-nav" aria-label="Navegación al pie">
          <div class="footer-group">
            <p class="footer-heading">Español</p>
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
          <div class="footer-group">
            <p class="footer-heading">Legal y transparencia</p>
            <a href="/compliance">Cumplimiento (EN)</a>
            <a href="/privacy/">Privacidad (EN)</a>
            <a href="/terms/">Términos (EN)</a>
            <a href="/about">Transparencia (EN)</a>
          </div>
        </nav>
        <div class="footer-meta">
          <span>Edición web educativa en español de USD Impact.</span>
          <span>Contenido educativo e informativo únicamente; no constituye asesoramiento de inversión, legal, fiscal ni de operativa, señal de trading ni recomendación.</span>
        </div>
      </div>
    </footer>
    <script>
      const navigation = document.querySelector("#site-navigation");
      const navigationToggle = document.querySelector(".nav-toggle");
      const setNavigationOpen = (open) => {
        if (!(navigation instanceof HTMLElement) || !(navigationToggle instanceof HTMLButtonElement)) return;
        navigation.dataset.open = String(open);
        navigationToggle.setAttribute("aria-expanded", String(open));
      };
      navigationToggle?.addEventListener("click", () => {
        const open = navigation instanceof HTMLElement && navigation.dataset.open === "true";
        setNavigationOpen(!open);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !window.matchMedia("(max-width: 760px)").matches) return;
        const open = navigation instanceof HTMLElement && navigation.dataset.open === "true";
        if (!open) return;
        setNavigationOpen(false);
        if (navigationToggle instanceof HTMLButtonElement) navigationToggle.focus();
      });
      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setNavigationOpen(false));
      });
    </script>
  </body>
</html>
