---
import BaseLayout from './BaseLayout.astro';

const {
  title,
  description,
  currentPath = '/es',
  englishPath = '/',
} = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  locale="es"
  currentPath={currentPath}
  alternateLocaleHref={englishPath}
  responsiveTables
>
  <slot />
</BaseLayout>
