---
import BaseLayout from './BaseLayout.astro';
import ConsentClient from '../components/ConsentClient.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  locale="es"
  noindex
  currentPath="/internal/localization/spanish-privacy-review"
  alternateLocaleHref="/privacy/"
>
  <main id="main-content" class="container legal-page">
    <section class="compliance" aria-label="Estado de revisión">
      <strong>ARCHIVO DE REVISIÓN — APROBADO POR EL PROPIETARIO:</strong>
      revisión de idioma PASS y revisión de privacidad del propietario PASS el 9 de octubre de 2026. No se realizó revisión jurídica externa.
      La analítica de <code>/es</code> continúa deshabilitada y la versión pública correspondiente utiliza <code>/es/privacy/</code>.
    </section>
    <slot />
  </main>
  <ConsentClient locale="es" privacyHref="/internal/localization/spanish-privacy-review/" />
</BaseLayout>
