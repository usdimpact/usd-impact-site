---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ComplianceNote from '../components/ComplianceNote.astro';
import ProductCTA from '../components/ProductCTA.astro';
import BookPurchaseCTA from '../components/BookPurchaseCTA.astro';
import FrameworkVisual from '../components/FrameworkVisual.astro';
import ThreeDialsSnapshot from '../components/ThreeDialsSnapshot.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

const checklistDownload = '/downloads/USD_Impact_Weekly_Dollar_Regime_Checklist_Lead_Magnet.pdf';
const bookSlug = '/book/read-the-dollar-first';
const threeDialsSlug = '/framework/three-dial-dashboard';

export async function getStaticPaths() {
  const collections = ['pages', 'products', 'frameworks', 'leadMagnets', 'benchmarkModules'];
  const all = (await Promise.all(collections.map(async (collection) => {
    return getCollection(collection);
  }))).flat().filter((entry) => entry.data.status === 'published');

  return all.map((entry) => ({
    params: { slug: entry.data.slug.replace(/^\//, '').replace(/\/$/, '') },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const normalizedSlug = entry.data.slug.replace(/\/$/, '');
const downloadPath = 'downloadPath' in entry.data && typeof entry.data.downloadPath === 'string'
  ? entry.data.downloadPath
  : checklistDownload;
const isBookPage = normalizedSlug === bookSlug;
const isThreeDialsPage = normalizedSlug === threeDialsSlug;
const requestedPrimary = entry.data.ctaPrimary;
const requestedPrimaryHref = entry.data.ctaPrimaryHref;
const requestedSecondaryHref = entry.data.ctaSecondaryHref;
const requestedSecondaryDownload = entry.data.ctaSecondaryDownload;
const isLibraryPassAcquisition = requestedPrimary === 'Get the book'
  || requestedPrimary === 'Explore the book';
const primaryLabel = isLibraryPassAcquisition
  ? 'Check Library Pass availability'
  : requestedPrimary;
const primaryHref = isLibraryPassAcquisition
  ? '/checkout/'
  : requestedPrimaryHref ?? `${bookSlug}/#book-waitlist`;
const secondaryHref = requestedSecondaryHref ?? downloadPath;
const secondaryDownload = requestedSecondaryDownload ?? requestedSecondaryHref === undefined;
---
<BaseLayout title={entry.data.metaTitle} description={entry.data.metaDescription}>
  <main id="main-content" class="main-with-hero">
    <section class:list={["hero", { "book-hero": isBookPage }]}>
      <div class="container">
        <div class="eyebrow">{entry.data.category}</div>
        <h1>{entry.data.title}</h1>
        {entry.data.hero && <p class="lead">{entry.data.hero}</p>}
        {isBookPage ? (
          <BookPurchaseCTA
            secondary={entry.data.ctaSecondary}
            secondaryHref={secondaryHref}
            secondaryDownload={secondaryDownload}
          />
        ) : (
          <ProductCTA
            primary={primaryLabel}
            primaryHref={primaryHref}
            secondary={entry.data.ctaSecondary}
            secondaryHref={secondaryHref}
            secondaryDownload={secondaryDownload}
            libraryPassAvailability={isLibraryPassAcquisition}
          />
        )}
      </div>
    </section>
    <div class:list={["container", "page-content", { "book-product-content": isBookPage }]}>
    {entry.data.visual && <FrameworkVisual src={entry.data.visual} alt={entry.data.title} />}
    {isThreeDialsPage && <ThreeDialsSnapshot />}
    <Content />
    {isBookPage && <WaitlistForm initiallyHidden />}
    <ComplianceNote text={entry.data.complianceNote} />
    </div>
  </main>
</BaseLayout>
