---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ComplianceNote from '../components/ComplianceNote.astro';
import ProductCTA from '../components/ProductCTA.astro';
import FrameworkVisual from '../components/FrameworkVisual.astro';

export async function getStaticPaths() {
  const collections = ['pages', 'products', 'frameworks', 'leadMagnets', 'benchmarkModules'];
  const all = (await Promise.all(collections.map(async (collection) => {
    return getCollection(collection);
  }))).flat().filter((entry) => entry.data.status === 'published');

  return all.map((entry) => ({
    params: { slug: entry.data.slug.replace(/^\//, '').replace(/\/$/, '') },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const downloadPath = 'downloadPath' in entry.data && typeof entry.data.downloadPath === 'string'
  ? entry.data.downloadPath
  : undefined;
---
<BaseLayout title={entry.data.metaTitle} description={entry.data.metaDescription}>
  <section class="hero">
    <div class="container">
      <div class="eyebrow">{entry.data.category}</div>
      <h1>{entry.data.title}</h1>
      {entry.data.hero && <p class="lead">{entry.data.hero}</p>}
      <ProductCTA
        primary={entry.data.ctaPrimary}
        secondary={entry.data.ctaSecondary}
        secondaryHref={downloadPath ?? '/lead-magnets/weekly-dollar-regime-checklist/'}
        secondaryDownload={Boolean(downloadPath)}
      />
    </div>
  </section>
  <main class="container">
    {entry.data.visual && <FrameworkVisual src={entry.data.visual} alt={entry.data.title} />}
    <Content />
    <ComplianceNote text={entry.data.complianceNote} />
  </main>
</BaseLayout>
