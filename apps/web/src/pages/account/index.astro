---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
---
<BaseLayout
  title="Your account | USD Impact"
  description="Manage your USD Impact learning access, data export, and account settings."
>
  <main id="main-content">
    <section class="hero account-hero">
      <div class="container">
        <p class="eyebrow">USD Impact account</p>
        <h1>Your learning account.</h1>
        <p class="lead">Pick up where you left off, explore another format, and manage your account securely.</p>
      </div>
    </section>

    <div class="container account-shell">
      <section class="card account-panel account-next-step" aria-labelledby="next-step-heading">
        <div class="account-section-heading">
          <Icon name="compass" class="account-icon account-icon-emphasis" />
          <div>
            <p class="eyebrow">Recommended next step</p>
            <h2 id="next-step-heading">Start with the Guided Edition</h2>
          </div>
        </div>
        <p id="next-step-description">Build the dollar-first framework chapter by chapter, with saved progress and short mastery checks.</p>
        <ul id="learning-progress-summary" class="account-progress-summary" aria-label="Saved learning progress" hidden>
          <li><strong id="learning-activity-count">0</strong><span>saved activities</span></li>
          <li><strong id="learning-completed-count">0</strong><span>completed</span></li>
          <li><strong id="learning-in-progress-count">0</strong><span>in progress</span></li>
        </ul>
        <a id="next-step-link" class="button primary" href="/guided-edition/">Start Guided Edition</a>
        <p id="learning-journey-note" class="account-help">
          Sign in status is loading. Your suggestion uses only progress already saved to your account.
        </p>
      </section>

      <section id="getting-started" class="card account-panel" aria-labelledby="how-to-heading" data-getting-started>
        <div data-getting-started-content>
          <div class="account-onboarding-heading">
            <div>
              <p class="eyebrow">Four useful first steps</p>
              <h2 id="how-to-heading">Getting started</h2>
            </div>
            <button class="account-quiet-button" type="button" data-dismiss-checklist>Dismiss checklist</button>
          </div>
          <p class="account-onboarding-intro">Progress is recognized from activity the product already saves. This checklist does not grant access or add a new tracking system.</p>
          <ol class="account-guide account-onboarding-list">
            <li data-onboarding-step="guided">
              <Icon name="book" class="account-icon" />
              <div>
                <strong>1. Open the Guided Edition</strong>
                <span>Build the dollar-first framework one chapter at a time.</span>
                <a class="account-text-link" href="/guided-edition/">Open Guided Edition →</a>
              </div>
              <span class="account-step-state" data-onboarding-status>Not started</span>
            </li>
            <li data-onboarding-step="audiobook">
              <Icon name="headphones" class="account-icon" />
              <div>
                <strong>2. Play an audiobook chapter</strong>
                <span>Reinforce the framework in the complete English audiobook.</span>
                <a class="account-text-link" href="/guided-edition/audiobook/">Open audiobook →</a>
              </div>
              <span class="account-step-state" data-onboarding-status>Not started</span>
            </li>
            <li data-onboarding-step="video">
              <Icon name="video" class="account-icon" />
              <div>
                <strong>3. Watch a recommended film</strong>
                <span>Use a focused lesson to revisit a concept visually.</span>
                <a class="account-text-link" href="/guided-edition/video-library/">Open Video Library →</a>
              </div>
              <span class="account-step-state" data-onboarding-status>Not started</span>
            </li>
            <li data-onboarding-step="support">
              <Icon name="support" class="account-icon" />
              <div>
                <strong>4. Locate Account &amp; Support</strong>
                <span>Know where to find receipts, security, data controls, and help.</span>
                <a class="account-text-link" href="#support-heading" data-find-support>Find support →</a>
              </div>
              <span class="account-step-state" data-onboarding-status>Ready</span>
            </li>
          </ol>
          <p class="account-help" data-onboarding-summary role="status" aria-live="polite">Your saved activity is loading.</p>
        </div>
        <div class="account-onboarding-dismissed" data-getting-started-dismissed hidden>
          <div>
            <p class="eyebrow">Getting started</p>
            <h2>Checklist hidden</h2>
            <p>You can bring back the four-step learning checklist at any time.</p>
          </div>
          <button class="button account-secondary" type="button" data-reset-checklist>Reset checklist view</button>
        </div>
      </section>

      <section class="card account-panel" aria-labelledby="formats-heading">
        <p class="eyebrow">Included formats</p>
        <h2 id="formats-heading">Explore another section</h2>
        <div class="account-format-grid">
          <article class="account-format-card">
            <Icon name="book" class="account-icon" />
            <h3>Guided Edition</h3>
            <p>Read, save your place, and complete mastery checks.</p>
            <a class="account-text-link" href="/guided-edition/">Open Guided Edition →</a>
          </article>
          <article class="account-format-card">
            <Icon name="headphones" class="account-icon" />
            <h3>Audiobook</h3>
            <p>Listen to the complete English edition at your pace.</p>
            <a class="account-text-link" href="/guided-edition/audiobook/">Open audiobook →</a>
          </article>
          <article class="account-format-card">
            <Icon name="video" class="account-icon" />
            <h3>Video Library</h3>
            <p>Watch focused lessons organized into clear collections.</p>
            <a class="account-text-link" href="/guided-edition/video-library/">Open Video Library →</a>
          </article>
        </div>
      </section>

      <section class="card account-panel" aria-labelledby="account-heading">
        <h2 id="account-heading">Account status</h2>
        <dl class="account-details">
          <div><dt>Email</dt><dd id="account-email">Loading…</dd></div>
          <div><dt>Account</dt><dd id="account-status">Loading…</dd></div>
          <div><dt>Paid access</dt><dd id="paid-access">Loading…</dd></div>
        </dl>
        <p class="account-help">
          This browser can stay signed in for up to 30 days when “Keep me signed in” is selected. The same sign-in
          covers the Guided Edition, digital reader, audiobook, and Video Library. On a shared device, sign out when
          finished.
        </p>
        <p id="account-message" class="account-status" role="status" aria-live="polite"></p>
        <div class="button-row account-actions">
          <a id="push-settings-link" class="button account-secondary" href="/account/notifications/" hidden>Browser notifications</a>
          <a id="passkey-settings-link" class="button account-secondary" href="/account/passkeys/" hidden>Passkeys &amp; security</a>
          <button id="export-account" class="button account-secondary" type="button">Download my data</button>
          <button id="sign-out" class="button account-secondary" type="button">Sign out</button>
        </div>
      </section>

      <section class="card account-panel" aria-labelledby="payment-records-heading">
        <h2 id="payment-records-heading">Payment receipt and invoice</h2>
        <p>
          Library access belongs to the USD Impact account shown above. The payment receipt and any invoice belong
          to the email entered in Lemon Squeezy checkout, which can be different when someone pays for another person.
        </p>
        <p>
          Use Lemon Squeezy My Orders with the checkout email to view the receipt, resend it, or generate an invoice.
          Invoice generation may require the purchaser's billing address.
        </p>
        <a
          class="button account-secondary"
          href="https://app.lemonsqueezy.com/my-orders"
          rel="noopener noreferrer"
        >Open Lemon Squeezy My Orders</a>
      </section>

      <section class="card account-panel" aria-labelledby="support-heading">
        <h2 id="support-heading">Contact support</h2>
        <p>
          Submit an account-linked support request. Do not include passwords, one-time codes,
          complete sign-in links, payment-card data, API keys, or provider secrets.
        </p>
        <form id="account-support-form" class="account-form">
          <label for="support-category">Category</label>
          <select id="support-category" name="category" required>
            <option value="access">Access</option>
            <option value="commerce">Commerce</option>
            <option value="privacy">Privacy</option>
            <option value="security">Security</option>
            <option value="product">Product</option>
            <option value="general">General</option>
          </select>

          <label for="support-subject">Subject</label>
          <input
            id="support-subject"
            name="subject"
            type="text"
            minlength="3"
            maxlength="160"
            autocomplete="off"
            required
          />

          <label for="support-message">Message</label>
          <textarea
            id="support-message"
            name="message"
            minlength="10"
            maxlength="5000"
            rows="7"
            required
          ></textarea>

          <button class="button primary" type="submit">Submit support request</button>
        </form>
        <p id="support-status" class="account-status" role="status" aria-live="polite"></p>
        <p class="account-help">
          For mailbox-based support, email <a href="mailto:support@usd-impact.com">support@usd-impact.com</a>.
        </p>
      </section>

      <section class="card account-panel account-danger" aria-labelledby="delete-heading">
        <h2 id="delete-heading">Delete account</h2>
        <p>
          Deletion ends paid access and starts a seven-day safety period. It does not create a refund.
          Certain transaction, tax, fraud, dispute, and audit records may be retained where required.
        </p>
        <button id="delete-account" class="button account-danger-button" type="button">Request account deletion</button>
      </section>
    </div>
  </main>

  <script>
    const message = document.getElementById('account-message');
    const email = document.getElementById('account-email');
    const accountStatus = document.getElementById('account-status');
    const paidAccess = document.getElementById('paid-access');
    const supportForm = document.getElementById('account-support-form');
    const supportStatus = document.getElementById('support-status');
    const pushSettingsLink = document.getElementById('push-settings-link');
    const passkeySettingsLink = document.getElementById('passkey-settings-link');
    const nextStepHeading = document.getElementById('next-step-heading');
    const nextStepDescription = document.getElementById('next-step-description');
    const nextStepLink = document.getElementById('next-step-link');
    const learningJourneyNote = document.getElementById('learning-journey-note');
    const learningProgressSummary = document.getElementById('learning-progress-summary');
    const learningActivityCount = document.getElementById('learning-activity-count');
    const learningCompletedCount = document.getElementById('learning-completed-count');
    const learningInProgressCount = document.getElementById('learning-in-progress-count');
    const gettingStartedContent = document.querySelector('[data-getting-started-content]');
    const gettingStartedDismissed = document.querySelector('[data-getting-started-dismissed]');
    const onboardingSummary = document.querySelector('[data-onboarding-summary]');
    const ONBOARDING_VIEW_KEY = 'usd-impact-getting-started-view-v1';
    const AUDIOBOOK_PROGRESS_KEY = 'usd-impact-library-pass-audiobook-progress';

    const defaultJourney = {
      available: false,
      activityCount: 0,
      completedCount: 0,
      inProgressCount: 0,
      nextStep: {
        title: 'Start with the Guided Edition',
        description: 'Build the dollar-first framework chapter by chapter, with saved progress and short mastery checks.',
        href: '/guided-edition/',
        ctaLabel: 'Start Guided Edition',
      },
    };

    const boundedCount = (value) => Number.isInteger(value) && value >= 0 ? Math.min(value, 500) : 0;
    const safeInternalHref = (value) => (
      typeof value === 'string'
        && value.startsWith('/')
        && !value.startsWith('//')
        && !value.includes('\\')
        && !/[\u0000-\u001f\u007f]/.test(value)
        ? value
        : '/guided-edition/'
    );

    const showLearningJourney = (journey, hasPaidAccess) => {
      const resolved = journey && typeof journey === 'object' ? journey : defaultJourney;
      const step = resolved.nextStep && typeof resolved.nextStep === 'object'
        ? resolved.nextStep
        : defaultJourney.nextStep;
      if (nextStepHeading) nextStepHeading.textContent = step.title || defaultJourney.nextStep.title;
      if (nextStepDescription) nextStepDescription.textContent = step.description || defaultJourney.nextStep.description;
      if (nextStepLink instanceof HTMLAnchorElement) {
        nextStepLink.href = safeInternalHref(step.href);
        nextStepLink.textContent = step.ctaLabel || defaultJourney.nextStep.ctaLabel;
      }

      const activityCount = boundedCount(resolved.activityCount);
      const completedCount = boundedCount(resolved.completedCount);
      const inProgressCount = boundedCount(resolved.inProgressCount);
      if (learningActivityCount) learningActivityCount.textContent = String(activityCount);
      if (learningCompletedCount) learningCompletedCount.textContent = String(completedCount);
      if (learningInProgressCount) learningInProgressCount.textContent = String(inProgressCount);
      if (learningProgressSummary) learningProgressSummary.hidden = !(hasPaidAccess && resolved.available === true);
      if (learningJourneyNote) {
        learningJourneyNote.textContent = !hasPaidAccess
          ? 'Learning-path suggestions become available with active Library Pass access.'
          : resolved.available === true
            ? 'This suggestion uses only learning progress already saved to your account; no additional activity tracking was added.'
            : 'Saved progress is temporarily unavailable. You can still start or continue from the Guided Edition.';
      }
      showGettingStarted(resolved, hasPaidAccess);
    };

    const readLocalFlag = (key) => {
      try {
        return localStorage.getItem(key) === 'true';
      } catch {
        return false;
      }
    };

    const audiobookStartedOnDevice = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(AUDIOBOOK_PROGRESS_KEY) || 'null');
        return Boolean(saved && Number.isFinite(saved.index) && Number.isFinite(saved.time));
      } catch {
        return false;
      }
    };

    const setOnboardingStep = (name, complete, incompleteLabel = 'Not started') => {
      const step = document.querySelector(`[data-onboarding-step="${name}"]`);
      const status = step?.querySelector('[data-onboarding-status]');
      if (!(step instanceof HTMLElement) || !(status instanceof HTMLElement)) return;
      step.dataset.complete = String(complete);
      status.textContent = complete ? 'Complete' : incompleteLabel;
    };

    const showGettingStarted = (journey, hasPaidAccess) => {
      const counts = journey?.formatCounts && typeof journey.formatCounts === 'object'
        ? journey.formatCounts
        : {};
      setOnboardingStep('guided', hasPaidAccess && boundedCount(counts.guidedEdition) > 0);
      setOnboardingStep('audiobook', hasPaidAccess && audiobookStartedOnDevice(), 'Open on this device');
      setOnboardingStep('video', hasPaidAccess && boundedCount(counts.video) > 0);
      setOnboardingStep('support', readLocalFlag(`${ONBOARDING_VIEW_KEY}:support`), 'Ready');
      const completed = document.querySelectorAll('[data-onboarding-step][data-complete="true"]').length;
      if (onboardingSummary) {
        onboardingSummary.textContent = hasPaidAccess
          ? `${completed} of 4 getting-started steps recognized.`
          : 'These learning steps become available with active Library Pass access.';
      }
    };

    const setChecklistDismissed = (dismissed) => {
      if (gettingStartedContent instanceof HTMLElement) gettingStartedContent.hidden = dismissed;
      if (gettingStartedDismissed instanceof HTMLElement) gettingStartedDismissed.hidden = !dismissed;
      try {
        localStorage.setItem(ONBOARDING_VIEW_KEY, String(dismissed));
      } catch {
        // Checklist visibility remains usable even when local storage is unavailable.
      }
    };

    setChecklistDismissed(readLocalFlag(ONBOARDING_VIEW_KEY));
    document.querySelector('[data-dismiss-checklist]')?.addEventListener('click', () => setChecklistDismissed(true));
    document.querySelector('[data-reset-checklist]')?.addEventListener('click', () => setChecklistDismissed(false));
    document.querySelector('[data-find-support]')?.addEventListener('click', () => {
      try {
        localStorage.setItem(`${ONBOARDING_VIEW_KEY}:support`, 'true');
      } catch {
        // The support link still works when local storage is unavailable.
      }
      setOnboardingStep('support', true);
    });

    const showMessage = (text, state = '') => {
      if (!message) return;
      message.textContent = text;
      message.dataset.state = state;
    };

    const showSupportMessage = (text, state = '') => {
      if (!supportStatus) return;
      supportStatus.textContent = text;
      supportStatus.dataset.state = state;
    };

    const loadNotificationSettingsAvailability = async () => {
      if (!pushSettingsLink) return;
      try {
        const response = await fetch('/api/account?action=push-subscription', { credentials: 'same-origin' });
        pushSettingsLink.hidden = !response.ok;
      } catch {
        pushSettingsLink.hidden = true;
      }
    };

    const loadPasskeySettingsAvailability = async () => {
      if (!passkeySettingsLink) return;
      try {
        const response = await fetch('/api/account?action=passkey&op=status', {
          credentials: 'same-origin',
          cache: 'no-store',
        });
        const body = await response.json().catch(() => ({}));
        passkeySettingsLink.hidden = !(response.ok && body.enabled === true);
      } catch {
        passkeySettingsLink.hidden = true;
      }
    };

    const loadAccount = async () => {
      showMessage('Loading account…', 'pending');
      const response = await fetch('/api/account-access', { credentials: 'same-origin' });
      if (response.status === 401) {
        window.location.replace('/account/sign-in/?next=/account/');
        return;
      }
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || 'Account details could not be loaded.');

      if (email) email.textContent = body.account?.email || 'Unavailable';
      if (accountStatus) accountStatus.textContent = body.account?.status || 'Unavailable';
      if (paidAccess) {
        paidAccess.textContent = body.paidAccess?.allowed
          ? 'Active'
          : `Not active (${body.paidAccess?.reason || 'unknown'})`;
      }
      showLearningJourney(body.learningJourney, body.paidAccess?.allowed === true);
      await Promise.all([
        loadNotificationSettingsAvailability(),
        loadPasskeySettingsAvailability(),
      ]);
      showMessage('Account loaded.', 'success');
    };

    supportForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = supportForm.querySelector('button[type="submit"]');
      const category = document.getElementById('support-category');
      const subject = document.getElementById('support-subject');
      const supportMessage = document.getElementById('support-message');
      if (!submit || !category || !subject || !supportMessage) return;

      submit.disabled = true;
      showSupportMessage('Recording your support request…', 'pending');
      try {
        const response = await fetch('/api/account-support', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            category: category.value,
            subject: subject.value,
            message: supportMessage.value,
          }),
        });
        if (response.status === 401) {
          window.location.replace('/account/sign-in/?next=/account/');
          return;
        }
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.error || 'The support request could not be recorded.');
        const reference = body.caseReference ? ` Reference: ${body.caseReference}.` : '';
        showSupportMessage(`Your support request is recorded.${reference}`, 'success');
        supportForm.reset();
      } catch (error) {
        showSupportMessage(
          error instanceof Error ? error.message : 'The support request could not be recorded.',
          'error'
        );
      } finally {
        submit.disabled = false;
      }
    });

    document.getElementById('export-account')?.addEventListener('click', async () => {
      showMessage('Preparing your export…', 'pending');
      const response = await fetch('/api/account-export', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        return showMessage(body.error || 'The export could not be created.', 'error');
      }
      const blob = await response.blob();
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'usd-impact-account-export.json';
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      showMessage('Export downloaded.', 'success');
    });

    document.getElementById('sign-out')?.addEventListener('click', async () => {
      await fetch('/api/auth-logout', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      window.location.replace('/account/sign-in/');
    });

    document.getElementById('delete-account')?.addEventListener('click', async () => {
      const confirmed = window.confirm(
        'Request account deletion? Paid access will stop and a seven-day safety period will begin. This does not create a refund.'
      );
      if (!confirmed) return;

      showMessage('Submitting deletion request…', 'pending');
      const response = await fetch('/api/account-delete', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) return showMessage(body.error || 'Deletion could not be requested.', 'error');
      showMessage(
        body.deletionDueAt
          ? `Deletion requested. Safety period ends ${new Date(body.deletionDueAt).toLocaleString()}.`
          : 'Deletion requested.',
        'success'
      );
      if (accountStatus) accountStatus.textContent = body.status || 'deletion_pending';
      if (paidAccess) paidAccess.textContent = 'Not active (deletion pending)';
    });

    loadAccount().catch((error) => {
      showMessage(error.message, 'error');
      if (learningJourneyNote) {
        learningJourneyNote.textContent = 'Account recommendations could not be loaded. You can still start or continue from the Guided Edition.';
      }
    });
  </script>
</BaseLayout>
