---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Your account | USD Impact"
  description="Manage your USD Impact learning access, data export, and account settings."
>
  <section class="hero account-hero">
    <div class="container">
      <p class="eyebrow">USD Impact account</p>
      <h1>Your learning account.</h1>
      <p class="lead">Review access status and manage your account securely.</p>
    </div>
  </section>

  <main>
    <div class="container account-shell">
      <section class="card account-panel" aria-labelledby="account-heading">
        <h2 id="account-heading">Account status</h2>
        <dl class="account-details">
          <div><dt>Email</dt><dd id="account-email">Loading…</dd></div>
          <div><dt>Account</dt><dd id="account-status">Loading…</dd></div>
          <div><dt>Paid access</dt><dd id="paid-access">Loading…</dd></div>
        </dl>
        <aside id="checkout-result" class="account-checkout-result" aria-live="polite" hidden>
          <h3 id="checkout-result-title">Checkout update</h3>
          <p id="checkout-result-message"></p>
          <div class="button-row account-actions">
            <a id="checkout-access-link" class="button primary" href="/guided-edition/" hidden>
              Open Guided Interactive Edition
            </a>
            <a class="button account-secondary" href="#billing-support">Billing support</a>
          </div>
        </aside>
        <p id="account-message" class="account-status" role="status" aria-live="polite"></p>
        <div class="button-row account-actions">
          <button id="refresh-session" class="button account-secondary" type="button">Refresh session</button>
          <button id="export-account" class="button account-secondary" type="button">Download my data</button>
          <button id="sign-out" class="button account-secondary" type="button">Sign out</button>
        </div>
      </section>

      <section id="learning-progress" class="card account-panel" aria-labelledby="learning-progress-heading" hidden>
        <p class="eyebrow">Guided Interactive Edition</p>
        <h2 id="learning-progress-heading">Continue learning</h2>
        <p id="learning-progress-summary">Loading your saved place…</p>
        <progress id="learning-progress-meter" max="100" value="0" aria-label="Chapter 1 progress"></progress>
        <div class="button-row account-actions">
          <a id="learning-resume-link" class="button primary" href="/guided-edition/chapter-1/">Open chapter</a>
        </div>
        <p id="learning-progress-status" class="account-status" role="status" aria-live="polite"></p>
      </section>

      <section id="billing-support" class="card account-panel" aria-labelledby="billing-support-heading">
        <h2 id="billing-support-heading">Billing &amp; purchase support</h2>
        <p>
          Paddle sends the purchase receipt and invoice link by email. If access is still pending,
          you see a possible duplicate charge, or you need help with a refund or invoice, send a secure request below.
        </p>
        <form id="billing-support-form" class="account-form">
          <label for="billing-support-category">What do you need help with?</label>
          <select id="billing-support-category" name="category" required>
            <option value="payment_confirmation">Payment confirmation or access</option>
            <option value="duplicate_charge">Possible duplicate charge</option>
            <option value="refund">Refund question</option>
            <option value="invoice">Invoice or receipt question</option>
            <option value="other_billing">Other billing question</option>
          </select>
          <label for="billing-support-message">Details</label>
          <textarea
            id="billing-support-message"
            name="message"
            minlength="20"
            maxlength="2000"
            rows="6"
            required
            placeholder="Describe what happened. You may include the Paddle transaction reference from your receipt, but never enter card details."
          ></textarea>
          <button class="button primary" type="submit">Send secure request</button>
        </form>
        <p id="billing-support-status" class="account-status" role="status" aria-live="polite"></p>
      </section>

      <section class="card account-panel account-danger" aria-labelledby="delete-heading">
        <h2 id="delete-heading">Delete account</h2>
        <p>
          Deletion ends paid access and starts a seven-day safety period. It does not create a refund.
          Certain transaction, tax, fraud, dispute, and audit records may be retained where required.
        </p>
        <button id="delete-account" class="button account-danger-button" type="button">Request account deletion</button>
      </section>
    </div>
  </main>

  <script is:inline>
    const message = document.getElementById('account-message');
    const email = document.getElementById('account-email');
    const accountStatus = document.getElementById('account-status');
    const paidAccess = document.getElementById('paid-access');
    const checkoutResult = document.getElementById('checkout-result');
    const checkoutResultTitle = document.getElementById('checkout-result-title');
    const checkoutResultMessage = document.getElementById('checkout-result-message');
    const checkoutAccessLink = document.getElementById('checkout-access-link');
    const learningProgress = document.getElementById('learning-progress');
    const learningProgressSummary = document.getElementById('learning-progress-summary');
    const learningProgressMeter = document.getElementById('learning-progress-meter');
    const learningResumeLink = document.getElementById('learning-resume-link');
    const learningProgressStatus = document.getElementById('learning-progress-status');
    const supportForm = document.getElementById('billing-support-form');
    const supportStatus = document.getElementById('billing-support-status');
    const checkoutReturn = new URLSearchParams(window.location.search).get('checkout');

    const showMessage = (text, state = '') => {
      if (!message) return;
      message.textContent = text;
      message.dataset.state = state;
    };

    const showSupportMessage = (text, state = '') => {
      if (!supportStatus) return;
      supportStatus.textContent = text;
      supportStatus.dataset.state = state;
    };

    const showCheckoutResult = ({ title, text, state, allowAccess = false }) => {
      if (!checkoutResult || !checkoutResultTitle || !checkoutResultMessage) return;
      checkoutResult.hidden = false;
      checkoutResult.dataset.state = state;
      checkoutResultTitle.textContent = title;
      checkoutResultMessage.textContent = text;
      if (checkoutAccessLink) checkoutAccessLink.hidden = !allowAccess;
    };

    const fetchAccount = async () => {
      const response = await fetch('/api/account-access', { credentials: 'same-origin' });
      if (response.status === 401) {
        window.location.replace('/account/sign-in/?next=/account/');
        return null;
      }
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || 'Account details could not be loaded.');
      return body;
    };

    const renderAccount = (body) => {
      if (!body) return;
      if (email) email.textContent = body.account?.email || 'Unavailable';
      if (accountStatus) accountStatus.textContent = body.account?.status || 'Unavailable';
      if (paidAccess) {
        paidAccess.textContent = body.paidAccess?.allowed
          ? 'Active'
          : `Not active (${body.paidAccess?.reason || 'unknown'})`;
      }
    };

    const loadLearningProgress = async (hasPaidAccess) => {
      if (!learningProgress) return;
      learningProgress.hidden = !hasPaidAccess;
      if (!hasPaidAccess) return;
      try {
        const response = await fetch(
          '/api/guided-progress?contentId=guided-edition%3Achapter-1',
          { credentials: 'same-origin' }
        );
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.error || 'Learning progress could not be loaded.');
        const progress = body.progress || {};
        const percent = Number.isInteger(progress.progressPercent) ? progress.progressPercent : 0;
        if (learningProgressMeter) learningProgressMeter.value = percent;
        if (learningProgressSummary) {
          learningProgressSummary.textContent = progress.completedAt
            ? 'Chapter 1 mastery is complete.'
            : `Chapter 1 is ${percent}% complete.`;
        }
        if (learningResumeLink) {
          const position = typeof progress.resumePosition === 'string'
            ? `#${encodeURIComponent(progress.resumePosition)}`
            : '';
          learningResumeLink.href = `/guided-edition/chapter-1/${position}`;
          learningResumeLink.textContent = percent > 0 ? 'Resume Chapter 1' : 'Start Chapter 1';
        }
        if (learningProgressStatus) learningProgressStatus.textContent = 'Saved progress loaded.';
      } catch (error) {
        if (learningProgressSummary) learningProgressSummary.textContent = 'Your chapter is available.';
        if (learningProgressStatus) {
          learningProgressStatus.textContent = error instanceof Error
            ? error.message
            : 'Learning progress could not be loaded.';
          learningProgressStatus.dataset.state = 'error';
        }
      }
    };

    const loadAccount = async ({ announce = true } = {}) => {
      if (announce) showMessage('Loading account…', 'pending');
      const body = await fetchAccount();
      renderAccount(body);
      await loadLearningProgress(body?.paidAccess?.allowed === true);
      if (announce && body) showMessage('Account loaded.', 'success');
      return body;
    };

    const wait = (milliseconds) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));

    const handleCheckoutReturn = async () => {
      if (checkoutReturn === 'cancelled') {
        await loadAccount();
        showCheckoutResult({
          title: 'Checkout closed',
          text: 'The checkout was closed before confirmation. No access change is made from the browser checkout alone.',
          state: 'neutral',
        });
        return;
      }

      if (checkoutReturn !== 'complete') {
        await loadAccount();
        return;
      }

      showMessage('Checking verified payment status…', 'pending');
      showCheckoutResult({
        title: 'Confirming payment',
        text: 'Paddle reported that checkout completed. Access will appear only after the signed payment event is verified.',
        state: 'pending',
      });

      for (let attempt = 0; attempt < 10; attempt += 1) {
        try {
          const body = await loadAccount({ announce: false });
          if (!body) return;
          if (body.paidAccess?.allowed) {
            showMessage('Verified payment confirmed.', 'success');
            showCheckoutResult({
              title: 'Payment confirmed — access is active',
              text: 'The verified Paddle payment event has been processed and your durable access is ready.',
              state: 'success',
              allowAccess: true,
            });
            return;
          }
          if (body.checkout?.status === 'failed') {
            showMessage('Payment was not completed.', 'error');
            showCheckoutResult({
              title: 'Payment not completed',
              text: 'The verified transaction status is failed, so no access was granted. You can try checkout again or send a billing-support request.',
              state: 'error',
            });
            return;
          }
        } catch (error) {
          if (attempt === 9) throw error;
        }
        await wait(1500);
      }

      showMessage('Payment confirmation is still pending.', 'pending');
      showCheckoutResult({
        title: 'Payment confirmation is still pending',
        text: 'No unverified access has been granted. Refresh this page shortly; if the status does not update, send a billing-support request below.',
        state: 'pending',
      });
    };

    document.getElementById('refresh-session')?.addEventListener('click', async () => {
      showMessage('Refreshing session…', 'pending');
      const response = await fetch('/api/auth-refresh', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) return showMessage(body.error || 'Session refresh failed.', 'error');
      await handleCheckoutReturn().catch((error) => showMessage(error.message, 'error'));
    });

    document.getElementById('export-account')?.addEventListener('click', async () => {
      showMessage('Preparing your export…', 'pending');
      const response = await fetch('/api/account-export', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        return showMessage(body.error || 'The export could not be created.', 'error');
      }
      const blob = await response.blob();
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'usd-impact-account-export.json';
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      showMessage('Export downloaded.', 'success');
    });

    document.getElementById('sign-out')?.addEventListener('click', async () => {
      await fetch('/api/auth-logout', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      window.location.replace('/account/sign-in/');
    });

    document.getElementById('delete-account')?.addEventListener('click', async () => {
      const confirmed = window.confirm(
        'Request account deletion? Paid access will stop and a seven-day safety period will begin. This does not create a refund.'
      );
      if (!confirmed) return;

      showMessage('Submitting deletion request…', 'pending');
      const response = await fetch('/api/account-delete', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) return showMessage(body.error || 'Deletion could not be requested.', 'error');
      showMessage(
        body.deletionDueAt
          ? `Deletion requested. Safety period ends ${new Date(body.deletionDueAt).toLocaleString()}.`
          : 'Deletion requested.',
        'success'
      );
      if (accountStatus) accountStatus.textContent = body.status || 'deletion_pending';
      if (paidAccess) paidAccess.textContent = 'Not active (deletion pending)';
    });

    supportForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const category = document.getElementById('billing-support-category');
      const details = document.getElementById('billing-support-message');
      const submit = supportForm.querySelector('button[type="submit"]');
      if (!category?.value || !details?.value || !submit) return;

      submit.disabled = true;
      showSupportMessage('Sending your secure request…', 'pending');
      try {
        const response = await fetch('/api/account-support', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category: category.value, message: details.value }),
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.error || 'The support request could not be sent.');
        details.value = '';
        showSupportMessage(
          `Request ${body.supportRequest?.id || ''} was received securely.`,
          'success'
        );
      } catch (error) {
        showSupportMessage(
          error instanceof Error ? error.message : 'The support request could not be sent.',
          'error'
        );
      } finally {
        submit.disabled = false;
      }
    });

    handleCheckoutReturn().catch((error) => showMessage(error.message, 'error'));
  </script>
</BaseLayout>
