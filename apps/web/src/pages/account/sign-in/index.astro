---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const turnstileSiteKey = String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '').trim();
---
<BaseLayout
  title="Sign in | USD Impact"
  description="Sign in securely to your USD Impact learning account with a passkey or one-time email link."
>
  <section class="hero account-hero">
    <div class="container">
      <p class="eyebrow">USD Impact account</p>
      <h1>Sign in without a password.</h1>
      <p class="lead">Use a registered passkey, or request a short-lived one-time email sign-in link.</p>
    </div>
  </section>

  <main>
    <div class="container account-shell">
      <section class="card account-panel" aria-labelledby="sign-in-heading">
        <h2 id="sign-in-heading">Secure sign-in</h2>
        <form id="passwordless-sign-in" class="account-form">
          <input id="account-next" type="hidden" value="/account/" />
          {turnstileSiteKey && (
            <div
              id="account-turnstile"
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-action="account_sign_in"
              data-theme="auto"
            ></div>
          )}

          <div id="passkey-sign-in" hidden>
            <button id="passkey-sign-in-button" class="button primary" type="button">Sign in with a passkey</button>
            <p class="account-help">
              Use the passkey saved in your device or password manager. Your browser may ask for a fingerprint,
              face, device PIN, or security key.
            </p>
          </div>

          <div id="email-sign-in-fields">
            <label for="account-email">Email address</label>
            <input
              id="account-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="254"
              required
            />
            <button class="button primary" type="submit">Send sign-in link</button>
          </div>

          <div id="email-code-sign-in" hidden>
            <label for="account-email-code">6-digit email code</label>
            <input
              id="account-email-code"
              name="email-code"
              type="text"
              autocomplete="one-time-code"
              inputmode="numeric"
              pattern="[0-9]{6}"
              maxlength="6"
            />
            <button id="email-code-verify-button" class="button account-secondary" type="button">Verify email code</button>
            <p class="account-help">
              Already have a code? Enter the email address and six-digit code from the sign-in email here. This
              works even if that email was requested in another browser context.
            </p>
          </div>
        </form>
        <p id="sign-in-status" class="account-status" role="status" aria-live="polite"></p>
        <p class="account-help">
          Email sign-in remains available as the recovery method. The response is deliberately neutral; if the
          address can be used, the email will arrive shortly and its sign-in credentials can be used only once.
        </p>
      </section>
    </div>
  </main>

  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
  <script is:inline src="/assets/passkey-browser.js" defer></script>

  <script>
    const form = document.getElementById('passwordless-sign-in');
    const emailInput = document.getElementById('account-email');
    const nextInput = document.getElementById('account-next');
    const status = document.getElementById('sign-in-status');
    const submit = form?.querySelector('button[type="submit"]');
    const turnstileContainer = document.getElementById('account-turnstile');
    const passkeyContainer = document.getElementById('passkey-sign-in');
    const passkeyButton = document.getElementById('passkey-sign-in-button');
    const emailCodeContainer = document.getElementById('email-code-sign-in');
    const emailCodeInput = document.getElementById('account-email-code');
    const emailCodeVerifyButton = document.getElementById('email-code-verify-button');
    let emailCodeEnabled = false;

    const safeNextPath = (value) => {
      const next = String(value || '').trim();
      if (!next.startsWith('/') || next.startsWith('//') || next.includes('\\') || next.length > 512) {
        return '/account/';
      }
      try {
        const parsed = new URL(next, window.location.origin);
        if (parsed.origin !== window.location.origin) return '/account/';
        return `${parsed.pathname}${parsed.search}${parsed.hash}`;
      } catch {
        return '/account/';
      }
    };

    const readCaptchaToken = () => turnstileContainer
      ? String(document.querySelector('input[name="cf-turnstile-response"]')?.value || '').trim()
      : '';

    const resetTurnstile = () => {
      if (turnstileContainer && window.turnstile?.reset) {
        try {
          window.turnstile.reset('#account-turnstile');
        } catch {
          // The security widget can recover on its own after navigation or reload.
        }
      }
    };

    const showStatus = (text, state = '') => {
      if (!status) return;
      status.dataset.state = state;
      status.textContent = text;
    };

    if (nextInput) {
      const requestedNext = new URLSearchParams(window.location.search).get('next');
      nextInput.value = safeNextPath(requestedNext);
    }

    const loadPasskeyAvailability = async () => {
      if (!passkeyContainer || !passkeyButton) return;
      try {
        const response = await fetch('/api/account?action=passkey&op=status', {
          credentials: 'same-origin',
          cache: 'no-store',
        });
        const body = await response.json().catch(() => ({}));
        passkeyContainer.hidden = !(response.ok && body.enabled === true && window.USDImpactPasskeys?.supported?.());
      } catch {
        passkeyContainer.hidden = true;
      }
    };

    const loadEmailCodeAvailability = async () => {
      if (!emailCodeContainer) return;
      try {
        const response = await fetch('/api/account?action=passkey&op=recovery-status', {
          credentials: 'same-origin',
          cache: 'no-store',
        });
        const body = await response.json().catch(() => ({}));
        emailCodeEnabled = response.ok && body.enabled === true;
        emailCodeContainer.hidden = !emailCodeEnabled;
      } catch {
        emailCodeEnabled = false;
        emailCodeContainer.hidden = true;
      }
    };

    passkeyButton?.addEventListener('click', async () => {
      if (!window.USDImpactPasskeys?.supported?.()) {
        showStatus('Passkeys are not supported by this browser or device.', 'error');
        return;
      }
      const captchaToken = readCaptchaToken();
      if (turnstileContainer && !captchaToken) {
        showStatus('Complete the security check before signing in with a passkey.', 'error');
        return;
      }

      passkeyButton.disabled = true;
      if (submit) submit.disabled = true;
      if (emailCodeVerifyButton) emailCodeVerifyButton.disabled = true;
      showStatus('Waiting for your passkey…', 'pending');
      try {
        const optionsResponse = await fetch('/api/account?action=passkey&op=authentication-options', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            ...(captchaToken ? { 'X-Turnstile-Token': captchaToken } : {}),
          },
          body: '{}',
        });
        const optionsBody = await optionsResponse.json().catch(() => ({}));
        if (!optionsResponse.ok) throw new Error(optionsBody.error || 'Passkey sign-in is unavailable.');

        const credential = await window.USDImpactPasskeys.get(optionsBody.options);
        const verifyResponse = await fetch('/api/account?action=passkey&op=authentication-verify', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            challengeId: optionsBody.challengeId,
            credential,
            next: nextInput?.value || '/account/',
          }),
        });
        const verifyBody = await verifyResponse.json().catch(() => ({}));
        if (!verifyResponse.ok) throw new Error(verifyBody.error || 'Passkey sign-in failed.');

        showStatus('Passkey accepted. Opening your account…', 'success');
        window.location.replace(safeNextPath(verifyBody.redirect || nextInput?.value || '/account/'));
      } catch (error) {
        const cancelled = error && (error.name === 'NotAllowedError' || error.name === 'AbortError');
        showStatus(
          cancelled
            ? 'Passkey sign-in was cancelled.'
            : (error instanceof Error ? error.message : 'Passkey sign-in failed.'),
          'error'
        );
      } finally {
        resetTurnstile();
        passkeyButton.disabled = false;
        if (submit) submit.disabled = false;
        if (emailCodeVerifyButton) emailCodeVerifyButton.disabled = false;
      }
    });

    emailCodeVerifyButton?.addEventListener('click', async () => {
      const emailValue = String(emailInput?.value || '').trim();
      const token = String(emailCodeInput?.value || '').trim();
      if (!emailValue) {
        showStatus('Enter the email address that received the code.', 'error');
        return;
      }
      if (!/^\d{6}$/.test(token)) {
        showStatus('Enter the six-digit code from the email.', 'error');
        return;
      }

      emailCodeVerifyButton.disabled = true;
      if (submit) submit.disabled = true;
      if (passkeyButton) passkeyButton.disabled = true;
      showStatus('Checking your email code…', 'pending');
      try {
        const response = await fetch('/api/account?action=passkey&op=recovery-verify', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: emailValue,
            token,
            next: nextInput?.value || '/account/',
          }),
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.error || 'The email code is invalid or expired.');

        showStatus('Email code accepted. Opening your account…', 'success');
        window.location.replace(safeNextPath(body.redirect || nextInput?.value || '/account/'));
      } catch (error) {
        showStatus(
          error instanceof Error ? error.message : 'The email code is invalid or expired.',
          'error'
        );
      } finally {
        emailCodeVerifyButton.disabled = false;
        if (submit) submit.disabled = false;
        if (passkeyButton) passkeyButton.disabled = false;
      }
    });

    emailCodeInput?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      emailCodeVerifyButton?.click();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!emailInput?.value || !submit || !status) return;

      const captchaToken = readCaptchaToken();
      if (turnstileContainer && !captchaToken) {
        showStatus('Complete the security check before requesting a sign-in email.', 'error');
        return;
      }

      submit.disabled = true;
      if (passkeyButton) passkeyButton.disabled = true;
      if (emailCodeVerifyButton) emailCodeVerifyButton.disabled = true;
      showStatus('Sending a secure sign-in email…', 'pending');

      try {
        const response = await fetch('/api/auth-login', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            ...(captchaToken ? { 'X-Turnstile-Token': captchaToken } : {}),
          },
          body: JSON.stringify({
            email: emailInput.value,
            next: nextInput?.value || '/account/',
          }),
        });

        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          throw new Error(body.error || 'The sign-in email could not be sent.');
        }

        if (emailCodeEnabled && emailCodeContainer && emailCodeInput) {
          emailCodeContainer.hidden = false;
          emailCodeInput.value = '';
          emailCodeInput.focus();
          showStatus('Check your email for the one-time sign-in link or six-digit code.', 'success');
        } else {
          showStatus('Check your email for the one-time sign-in link.', 'success');
          emailInput.value = '';
        }
      } catch (error) {
        showStatus(
          error instanceof Error ? error.message : 'The sign-in email could not be sent.',
          'error'
        );
      } finally {
        resetTurnstile();
        submit.disabled = false;
        if (passkeyButton) passkeyButton.disabled = false;
        if (emailCodeVerifyButton) emailCodeVerifyButton.disabled = false;
      }
    });

    loadPasskeyAvailability();
    loadEmailCodeAvailability();
  </script>
</BaseLayout>
