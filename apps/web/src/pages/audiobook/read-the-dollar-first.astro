---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudiobookPlayer from '../../components/AudiobookPlayer.astro';
import ComplianceNote from '../../components/ComplianceNote.astro';
import { readTheDollarFirstAudiobook } from '../../data/read-the-dollar-first-audiobook.js';
---
<BaseLayout
  title="Read the Dollar First English Audiobook | USD Impact"
  description="Explore the English audiobook edition of Read the Dollar First. Full chapter playback is included with the permanent USD Impact Library Pass."
>
  <section class="hero audiobook-hero">
    <div class="container">
      <div class="eyebrow">Library Pass audiobook</div>
      <h1>Listen chapter by chapter.</h1>
      <p class="lead">
        Explore the 20-chapter English narration of <em>Read the Dollar First</em>. Full playback is reserved for the verified account that owns the permanent Library Pass.
      </p>
      <div class="audiobook-hero-meta" aria-label="Audiobook details">
        <span>20 chapters</span>
        <span>{readTheDollarFirstAudiobook.duration}</span>
        <span>Human-reviewed narration</span>
      </div>
    </div>
  </section>

  <main class="container audiobook-page">
    <AudiobookPlayer {...readTheDollarFirstAudiobook} />

    <section class="audiobook-about" aria-labelledby="audiobook-about-heading">
      <div>
        <div class="eyebrow">How to use it</div>
        <h2 id="audiobook-about-heading">Permanent access through your Library Pass.</h2>
        <p>
          Sign in with the account used for purchase, choose any chapter, and continue at your preferred speed. Your chapter and listening position are stored only in this browser. Research Membership is not required for this audiobook.
        </p>
      </div>
      <div class="button-row">
        <a class="button primary" href="/book/read-the-dollar-first/">Explore the Library Pass</a>
        <a class="button account-secondary" href="/account/">Review account access</a>
      </div>
    </section>

    <ComplianceNote text="Educational and informational only. Not personalized investment, financial, legal, tax, or trading advice; not a trading signal; and not a recommendation to buy or sell any asset. Market relationships are conditional and may change across regimes." />
  </main>
</BaseLayout>
