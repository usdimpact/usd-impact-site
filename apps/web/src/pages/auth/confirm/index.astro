---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Confirm sign-in | USD Impact"
  description="Complete your secure USD Impact account sign-in."
>
  <main>
    <div class="container account-shell">
      <section class="card account-panel" aria-labelledby="confirm-heading">
        <p class="eyebrow">Secure sign-in</p>
        <h1 id="confirm-heading" class="account-title">Confirming your email…</h1>
        <p id="confirm-status" class="account-status" data-state="pending" role="status" aria-live="polite">
          Please keep this page open while the one-time link is verified.
        </p>
        <p><a href="/account/sign-in/">Return to sign in</a></p>
      </section>
    </div>
  </main>

  <script is:inline>
    const status = document.getElementById('confirm-status');
    const params = new URLSearchParams(window.location.search);
    const tokenHash = params.get('token_hash');
    const code = params.get('code');
    const type = params.get('type') || 'magiclink';
    const next = params.get('next') || '/account/';

    const sanitizedUrl = new URL(window.location.href);
    sanitizedUrl.searchParams.delete('token_hash');
    sanitizedUrl.searchParams.delete('code');
    sanitizedUrl.searchParams.delete('type');
    window.history.replaceState({}, document.title, `${sanitizedUrl.pathname}${sanitizedUrl.search}${sanitizedUrl.hash}`);

    const fail = (message) => {
      if (!status) return;
      status.dataset.state = 'error';
      status.textContent = message;
    };

    const finish = async () => {
      if (!status) return;

      try {
        if (tokenHash) {
          const response = await fetch('/api/auth-confirm', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token_hash: tokenHash, type, next }),
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(body.error || 'The sign-in link could not be verified.');

          status.dataset.state = 'success';
          status.textContent = 'Email confirmed. Redirecting to your account…';
          window.location.replace(body.redirectTo || '/account/');
          return;
        }

        if (code) {
          const target = new URL('/api/auth-confirm', window.location.origin);
          target.searchParams.set('code', code);
          target.searchParams.set('next', next);
          window.location.replace(`${target.pathname}${target.search}`);
          return;
        }

        fail('This sign-in link is incomplete or expired.');
      } catch (error) {
        fail(error instanceof Error
          ? error.message
          : 'The sign-in link could not be verified.');
      }
    };

    finish();
  </script>
</BaseLayout>
