---
import BaseLayout from '../../layouts/BaseLayout.astro';

const clientToken = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN || '';
---

<BaseLayout
  title="Secure checkout | USD Impact"
  description="Complete your USD Impact purchase securely with Paddle."
>
  <main class="account-main">
    <section class="account-panel" aria-labelledby="checkout-title">
      <p class="eyebrow">USD IMPACT CHECKOUT</p>
      <h1 id="checkout-title">Secure checkout</h1>
      <p id="checkout-status" role="status" aria-live="polite">
        Preparing your secure Paddle checkout…
      </p>
      <p>
        Payment details are collected by Paddle. Access is activated only after a verified payment event is processed.
      </p>
      <p>
        <a href="/account/">Return to your account</a>
      </p>
    </section>
  </main>

  <div
    id="paddle-checkout-config"
    data-client-token={clientToken}
    data-account-return="/account/?checkout=complete"
    hidden
  ></div>

  <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
  <script is:inline>
    const config = document.getElementById('paddle-checkout-config');
    const status = document.getElementById('checkout-status');
    const token = config?.dataset.clientToken || '';
    const returnPath = config?.dataset.accountReturn || '/account/';
    const parameters = new URLSearchParams(window.location.search);
    const transactionId =
      parameters.get('_ptxn') ||
      parameters.get('ptxn') ||
      parameters.get('transaction_id') ||
      '';

    function setStatus(message) {
      if (status) status.textContent = message;
    }

    if (!/^test_[a-zA-Z0-9]{27}$/.test(token)) {
      setStatus('Checkout is temporarily unavailable because the sandbox client token is missing.');
    } else if (!/^txn_[a-z0-9]{26}$/.test(transactionId)) {
      setStatus('This checkout link is invalid or incomplete. Return to your account and start checkout again.');
    } else if (!window.Paddle) {
      setStatus('Paddle Checkout could not load. Refresh this page and try again.');
    } else {
      window.Paddle.Environment.set('sandbox');
      window.Paddle.Initialize({
        token,
        eventCallback(event) {
          if (event?.name === 'checkout.completed') {
            setStatus('Payment received. Confirming your access…');
            window.setTimeout(() => {
              window.location.assign(returnPath);
            }, 1200);
          }
        },
      });

      setStatus('Opening secure checkout…');
      window.Paddle.Checkout.open({
        transactionId,
        settings: {
          displayMode: 'overlay',
          theme: 'light',
          locale: 'en',
          allowLogout: false,
        },
      });
    }
  </script>
</BaseLayout>
