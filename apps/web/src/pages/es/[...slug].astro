---
import { getCollection, render } from 'astro:content';
import SpanishPreviewLayout from '../../layouts/SpanishPreviewLayout.astro';
import SpanishPreviewDollarTransmissionVisual from '../../components/SpanishPreviewDollarTransmissionVisual.astro';
import SpanishPreviewThreeDialVisual from '../../components/SpanishPreviewThreeDialVisual.astro';
import { isLocalePublicationEnabled } from '../../lib/localization-policy.js';

export async function getStaticPaths() {
  if (!isLocalePublicationEnabled('es')) return [];

  const SPANISH_TO_ENGLISH_PATH = Object.freeze({
    '/es': '/',
    '/es/start-here': '/start-here/',
    '/es/dollar-framework': '/dollar-framework/',
    '/es/framework/dollar-transmission-chain': '/framework/dollar-transmission-chain/',
    '/es/framework/three-dial-dashboard': '/framework/three-dial-dashboard/',
  });

  const AUTHORIZED_SPANISH_PUBLIC_SLUGS = Object.freeze([
    '/es',
    '/es/start-here',
    '/es/dollar-framework',
    '/es/framework/dollar-transmission-chain',
    '/es/framework/three-dial-dashboard',
  ]);

  const collections = ['pages', 'frameworks'];
  const entries = (await Promise.all(collections.map((collection) => getCollection(collection))))
    .flat()
    .filter((entry) => (
      entry.data.status === 'published'
      && AUTHORIZED_SPANISH_PUBLIC_SLUGS.includes(entry.data.slug)
    ));

  return entries.map((entry) => {
    const rest = entry.data.slug
      .replace(/^\/es\/?/, '')
      .replace(/\/$/, '');

    return {
      params: { slug: rest || undefined },
      props: { entry, englishPath: SPANISH_TO_ENGLISH_PATH[entry.data.slug] },
    };
  });
}

const { entry, englishPath } = Astro.props;
const { Content } = await render(entry);
const currentPath = entry.data.slug.replace(/\/$/, '') || '/es';
const frameworkVisual = currentPath === '/es/framework/three-dial-dashboard'
  ? 'three-dial'
  : (
      currentPath === '/es/dollar-framework'
      || currentPath === '/es/framework/dollar-transmission-chain'
    )
    ? 'transmission'
    : null;
---
<SpanishPreviewLayout
  title={entry.data.metaTitle}
  description={entry.data.metaDescription}
  currentPath={currentPath}
  englishPath={englishPath}
>
  <main id="main-content" class="main-with-hero">
    <section class="hero">
      <div class="container">
        <div class="eyebrow">{entry.data.category}</div>
        <h1>{entry.data.title}</h1>
        {entry.data.hero && <p class="lead">{entry.data.hero}</p>}
      </div>
    </section>
    <div class="container page-content">
      {frameworkVisual === 'transmission' && <SpanishPreviewDollarTransmissionVisual />}
      {frameworkVisual === 'three-dial' && <SpanishPreviewThreeDialVisual />}
      <Content />
      <section class="compliance" aria-label="Nota de cumplimiento">
        <strong>Nota de cumplimiento:</strong> {entry.data.complianceNote}
      </section>
    </div>
  </main>
</SpanishPreviewLayout>
