---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Guided Interactive Edition | USD Impact"
  description="Secure account access to the Read the Dollar First Guided Interactive Edition."
>
  <section class="hero account-hero">
    <div class="container">
      <p class="eyebrow">Read the Dollar First</p>
      <h1>Guided Interactive Edition.</h1>
      <p class="lead">Your verified account has active access to the protected digital reading experience.</p>
    </div>
  </section>

  <main>
    <div class="container account-shell">
      <section class="card account-panel" aria-labelledby="guided-edition-heading">
        <h2 id="guided-edition-heading">Access confirmed</h2>
        <p>
          This protected entry point is now enforced by the durable Supabase entitlement attached to your account.
          The full guided reading interface will be delivered inside this protected route family.
        </p>
        <div class="button-row account-actions">
          <a class="button primary" href="/account/">Open account</a>
          <a class="button account-secondary" href="/book/read-the-dollar-first/">View book overview</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
