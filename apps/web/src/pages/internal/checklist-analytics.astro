---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Checklist Download Analytics | USD Impact"
  description="Private aggregate usage reporting for the Weekly Dollar Regime Checklist."
  noindex
>
  <section class="hero analytics-hero">
    <div class="container">
      <div class="eyebrow">Internal analytics</div>
      <h1>Checklist download activity</h1>
      <p class="lead">Aggregate, privacy-limited counts for the Weekly Dollar Regime Checklist.</p>
    </div>
  </section>

  <main class="container analytics-main">
    <section class="card analytics-access" aria-labelledby="analytics-access-heading">
      <div>
        <div class="eyebrow">Protected report</div>
        <h2 id="analytics-access-heading">Load aggregate statistics</h2>
        <p>The reporting token stays in this browser tab's memory and is sent only in the Authorization header.</p>
      </div>
      <form id="analytics-form" class="analytics-form">
        <label>
          Reporting token
          <input id="report-token" name="token" type="password" autocomplete="off" spellcheck="false" />
        </label>
        <label>
          Period ending
          <input id="report-end" name="end" type="date" required />
        </label>
        <label>
          Range
          <select id="report-days" name="days">
            <option value="7">7 days</option>
            <option value="14">14 days</option>
            <option value="30" selected>30 days</option>
          </select>
        </label>
        <button id="load-report" class="button primary" type="submit">Load report</button>
      </form>
      <p id="analytics-status" class="analytics-status" role="status" aria-live="polite"></p>
    </section>

    <section id="analytics-dashboard" class="analytics-dashboard" hidden>
      <div class="section-heading">
        <div>
          <div class="eyebrow">Checklist performance</div>
          <h2 id="report-range">Selected period</h2>
        </div>
        <button id="download-csv" class="button" type="button">Download CSV</button>
      </div>

      <div class="analytics-metrics">
        <article class="card"><span>Lifetime downloads</span><strong id="metric-lifetime">0</strong></article>
        <article class="card"><span>Selected period</span><strong id="metric-range">0</strong></article>
        <article class="card"><span>Previous period</span><strong id="metric-previous">0</strong></article>
        <article class="card"><span>Period change</span><strong id="metric-change">—</strong></article>
        <article class="card"><span>Active days</span><strong id="metric-active">0</strong></article>
        <article class="card"><span>Daily average</span><strong id="metric-average">0</strong></article>
      </div>

      <section class="card analytics-chart-card" aria-labelledby="daily-downloads-heading">
        <div>
          <h3 id="daily-downloads-heading">Daily downloads</h3>
          <p id="latest-download">No downloads in the selected period.</p>
        </div>
        <ol id="daily-downloads" class="analytics-bars"></ol>
      </section>

      <section class="analytics-attribution" aria-labelledby="attribution-heading">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Attribution</div>
            <h2 id="attribution-heading">Where downloads originate</h2>
          </div>
        </div>
        <p class="analytics-note">Attribution counters accumulate from this dashboard release onward. Earlier downloads remain included in the lifetime total.</p>
        <div class="analytics-attribution-grid">
          <article class="card"><h3>Page routes</h3><ol id="top-routes"></ol></article>
          <article class="card"><h3>UTM sources</h3><ol id="top-sources"></ol></article>
          <article class="card"><h3>UTM mediums</h3><ol id="top-mediums"></ol></article>
          <article class="card"><h3>UTM campaigns</h3><ol id="top-campaigns"></ol></article>
        </div>
      </section>
    </section>
  </main>
</BaseLayout>

<script>
  // @ts-nocheck
  const form = document.querySelector('#analytics-form');
  const tokenInput = document.querySelector('#report-token');
  const endInput = document.querySelector('#report-end');
  const daysInput = document.querySelector('#report-days');
  const loadButton = document.querySelector('#load-report');
  const status = document.querySelector('#analytics-status');
  const dashboard = document.querySelector('#analytics-dashboard');
  const csvButton = document.querySelector('#download-csv');
  let reportToken = '';
  let latestReport = null;

  endInput.value = new Date().toISOString().slice(0, 10);

  const number = (value) => new Intl.NumberFormat('en').format(value);
  const date = (value) => new Intl.DateTimeFormat('en', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
  }).format(new Date(`${value}T12:00:00Z`));

  const setText = (selector, value) => {
    const element = document.querySelector(selector);
    if (element) element.textContent = value;
  };

  const renderRanking = (selector, entries) => {
    const list = document.querySelector(selector);
    if (!list) return;
    list.replaceChildren();
    if (!entries.length) {
      const empty = document.createElement('li');
      empty.textContent = 'No attributed downloads yet.';
      list.append(empty);
      return;
    }
    for (const entry of entries) {
      const item = document.createElement('li');
      const label = document.createElement('span');
      const value = document.createElement('strong');
      label.textContent = entry.label;
      value.textContent = number(entry.value);
      item.append(label, value);
      list.append(item);
    }
  };

  const renderDaily = (entries) => {
    const list = document.querySelector('#daily-downloads');
    if (!list) return;
    list.replaceChildren();
    const maximum = Math.max(1, ...entries.map((entry) => entry.downloads));
    for (const entry of entries) {
      const item = document.createElement('li');
      const label = document.createElement('time');
      const track = document.createElement('span');
      const bar = document.createElement('i');
      const value = document.createElement('strong');
      label.dateTime = entry.date;
      label.textContent = entry.date.slice(5);
      track.className = 'analytics-bar-track';
      bar.style.width = `${Math.max(entry.downloads > 0 ? 4 : 0, (entry.downloads / maximum) * 100)}%`;
      track.append(bar);
      value.textContent = number(entry.downloads);
      item.append(label, track, value);
      list.append(item);
    }
  };

  const renderReport = (report) => {
    const checklist = report.checklist;
    setText('#report-range', `${date(report.range.start)}–${date(report.range.end)}`);
    setText('#metric-lifetime', number(checklist.lifetimeDownloads));
    setText('#metric-range', number(checklist.rangeDownloads));
    setText('#metric-previous', number(checklist.previousRangeDownloads));
    setText('#metric-change', checklist.changePercent === null
      ? 'No baseline'
      : `${checklist.changePercent >= 0 ? '+' : ''}${checklist.changePercent}%`);
    setText('#metric-active', `${checklist.activeDays}/${report.range.days}`);
    setText('#metric-average', number(checklist.averagePerDay));
    setText('#latest-download', checklist.mostRecentDownloadDate
      ? `Most recent download: ${date(checklist.mostRecentDownloadDate)}.`
      : 'No downloads in the selected period.');
    renderDaily(checklist.daily);
    renderRanking('#top-routes', checklist.attribution.routes);
    renderRanking('#top-sources', checklist.attribution.sources);
    renderRanking('#top-mediums', checklist.attribution.mediums);
    renderRanking('#top-campaigns', checklist.attribution.campaigns);
    dashboard.hidden = false;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    reportToken = tokenInput.value.trim() || reportToken;
    if (!reportToken) {
      status.textContent = 'Enter the reporting token.';
      return;
    }

    loadButton.disabled = true;
    status.textContent = 'Loading aggregate statistics…';
    try {
      const query = new URLSearchParams({ end: endInput.value, days: daysInput.value });
      const response = await fetch(`/api/checklist-analytics?${query}`, {
        headers: { Authorization: `Bearer ${reportToken}` },
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || `Report request failed (${response.status}).`);
      latestReport = payload;
      tokenInput.value = '';
      renderReport(payload);
      status.textContent = `Updated ${new Date(payload.generatedAt).toLocaleString()}.`;
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Unable to load checklist analytics.';
    } finally {
      loadButton.disabled = false;
    }
  });

  csvButton.addEventListener('click', () => {
    if (!latestReport) return;
    const rows = [
      ['date', 'downloads'],
      ...latestReport.checklist.daily.map((entry) => [entry.date, entry.downloads]),
    ];
    const csv = rows.map((row) => row.join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    const link = document.createElement('a');
    link.href = url;
    link.download = `checklist-downloads-${latestReport.range.end}.csv`;
    link.click();
    URL.revokeObjectURL(url);
  });
</script>

<style>
  .analytics-hero { padding-bottom: 56px; }
  .analytics-main { display: grid; gap: 56px; }
  .analytics-access { display: grid; gap: 24px; border-left: 5px solid var(--gold); }
  .analytics-access h2, .analytics-access p { margin: 6px 0 0; }
  .analytics-access p { color: var(--slate); }
  .analytics-form { display: grid; grid-template-columns: minmax(240px, 1fr) 180px 150px auto; gap: 14px; align-items: end; }
  .analytics-form label { display: grid; gap: 7px; color: var(--slate); font-size: 13px; font-weight: 800; }
  .analytics-form input, .analytics-form select { min-height: 44px; padding: 9px 11px; border: 1px solid #cdd4dc; border-radius: 8px; background: var(--white); color: var(--midnight); }
  .analytics-status { min-height: 24px; margin: 0; color: var(--slate); }
  .analytics-dashboard { display: grid; gap: 28px; }
  .analytics-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .analytics-metrics article { display: grid; gap: 8px; }
  .analytics-metrics span { color: var(--slate); font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .analytics-metrics strong { color: var(--navy); font-size: 32px; }
  .analytics-chart-card { display: grid; gap: 22px; }
  .analytics-chart-card h3, .analytics-chart-card p { margin: 0; }
  .analytics-chart-card p, .analytics-note { color: var(--slate); }
  .analytics-bars { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .analytics-bars li { display: grid; grid-template-columns: 52px minmax(0, 1fr) 40px; gap: 12px; align-items: center; }
  .analytics-bars time { color: var(--slate); font-size: 12px; }
  .analytics-bars strong { text-align: right; }
  .analytics-bar-track { height: 10px; overflow: hidden; border-radius: 999px; background: #e5e9ee; }
  .analytics-bar-track i { display: block; height: 100%; border-radius: inherit; background: var(--gold); }
  .analytics-attribution-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .analytics-attribution-grid h3 { margin-top: 0; }
  .analytics-attribution-grid ol { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .analytics-attribution-grid li { display: flex; justify-content: space-between; gap: 16px; color: var(--slate); }
  .analytics-attribution-grid li strong { color: var(--navy); }
  .analytics-note { margin-top: -12px; }
  @media (max-width: 820px) {
    .analytics-form, .analytics-metrics, .analytics-attribution-grid { grid-template-columns: 1fr; }
    .analytics-form .button { justify-self: start; }
  }
</style>
