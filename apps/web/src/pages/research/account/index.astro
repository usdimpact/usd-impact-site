---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Research account | USD Impact"
  description="Review your USD Impact Research Membership access and billing-management path."
  noindex={true}
>
  <main id="main-content">
    <section class="hero account-hero">
      <div class="container">
        <p class="eyebrow">Research Membership</p>
        <h1>Your Research account.</h1>
        <p class="lead">Review Research access separately from your permanent Library Pass and manage recurring billing with Lemon Squeezy.</p>
      </div>
    </section>

    <div class="container account-shell">
      <section class="card account-panel" aria-labelledby="research-status-heading">
        <p class="eyebrow">Research Membership</p>
        <h2 id="research-status-heading">Access status</h2>
        <dl class="account-details">
          <div><dt>Email</dt><dd id="research-account-email">Loading…</dd></div>
          <div><dt>Account</dt><dd id="research-account-status">Loading…</dd></div>
          <div><dt>Research access</dt><dd id="research-access-status">Loading…</dd></div>
          <div><dt>Access through</dt><dd id="research-access-end">Loading…</dd></div>
        </dl>
        <p id="research-account-message" class="account-status" role="status" aria-live="polite">Loading Research Membership status…</p>
        <div class="button-row account-actions">
          <a class="button" href="/research/">Research overview</a>
          <a class="button" href="/research/sample/">Public sample</a>
          <a class="button account-secondary" href="/account/">Main account</a>
        </div>
      </section>

      <section class="card account-panel" aria-labelledby="research-billing-heading">
        <p class="eyebrow">Billing and cancellation</p>
        <h2 id="research-billing-heading">Manage recurring billing with Lemon Squeezy</h2>
        <p>
          Use Lemon Squeezy My Orders with the email used at checkout to view the subscription and available billing controls.
          Canceling prevents the next renewal; Research access continues through the current paid billing period unless mandatory law
          or an approved refund requires an earlier access change.
        </p>
        <p>
          Research Membership billing is independent from Library Pass. Canceling, refunding, suspending, or ending Research Membership
          never removes permanent Library Pass access.
        </p>
        <a
          class="button primary"
          href="https://app.lemonsqueezy.com/my-orders"
          target="_blank"
          rel="noopener noreferrer"
        >Open Lemon Squeezy My Orders</a>
      </section>

      <section class="card account-panel" aria-labelledby="research-help-heading">
        <h2 id="research-help-heading">Need help?</h2>
        <p>
          For a billing or access mismatch, use the main account support form or email support. Do not send passwords,
          one-time codes, full sign-in links, payment-card data, API keys, or provider secrets.
        </p>
        <div class="button-row account-actions">
          <a class="button" href="/account/#support-heading">Open account support</a>
          <a class="button" href="mailto:support@usd-impact.com">Email support@usd-impact.com</a>
        </div>
      </section>
    </div>
  </main>

  <script>
    const email = document.getElementById('research-account-email');
    const accountStatus = document.getElementById('research-account-status');
    const accessStatus = document.getElementById('research-access-status');
    const accessEnd = document.getElementById('research-access-end');
    const message = document.getElementById('research-account-message');

    const setMessage = (text, state = '') => {
      if (!message) return;
      message.textContent = text;
      message.dataset.state = state;
    };

    const formatAccessEnd = (value) => {
      if (!value) return 'No active paid-through date';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Unavailable';
      return date.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
    };

    const loadResearchAccount = async () => {
      const response = await fetch('/api/research-account', {
        credentials: 'same-origin',
        cache: 'no-store',
      });
      if (response.status === 401) {
        window.location.replace('/account/sign-in/?next=/research/account/');
        return;
      }
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || 'Research Membership status could not be loaded.');

      if (email) email.textContent = body.account?.email || 'Unavailable';
      if (accountStatus) accountStatus.textContent = body.account?.status || 'Unavailable';
      if (accessStatus) {
        accessStatus.textContent = body.researchAccess?.allowed
          ? 'Active'
          : `Not active (${body.researchAccess?.reason || 'unknown'})`;
      }
      if (accessEnd) accessEnd.textContent = formatAccessEnd(body.researchAccess?.endsAt);
      setMessage(
        body.researchAccess?.allowed
          ? 'Research Membership access is active for this account.'
          : 'No active Research Membership entitlement is currently associated with this account.',
        body.researchAccess?.allowed ? 'success' : 'pending'
      );
    };

    loadResearchAccount().catch((error) => {
      setMessage(
        error instanceof Error ? error.message : 'Research Membership status could not be loaded.',
        'error'
      );
      if (email) email.textContent = 'Unavailable';
      if (accountStatus) accountStatus.textContent = 'Unavailable';
      if (accessStatus) accessStatus.textContent = 'Unavailable';
      if (accessEnd) accessEnd.textContent = 'Unavailable';
    });
  </script>
</BaseLayout>
