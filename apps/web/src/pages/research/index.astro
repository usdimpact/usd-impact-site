---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Research Membership | USD Impact"
  description="USD Impact Research Membership: new subscriptions are paused while paid benefits and source rights are verified. Daily news, the public sample and some historical reports remain free."
>
  <main id="main-content">
    <section class="hero reports-hero">
      <div class="container">
        <p class="eyebrow">USD Impact Research Membership</p>
        <h1>Go deeper than the daily update.</h1>
        <p class="lead">
          A separate Research subscription intended for additional research beyond USD Impact's free educational content.
          New subscriptions are paused. Daily News, the public sample, and some full historical Weekly and Monthly reports remain free.
        </p>
        <div class="button-row">
          <a class="button primary" href="/research/sample/">Read the complete public sample</a>
          <a class="button account-secondary" href="/research/account/">Research account</a>
        </div>
        <p class="edition-meta">New Research Membership subscriptions are temporarily paused while paid benefits and source rights are verified. No new checkout is available from this page.</p>
      </div>
    </section>

    <div class="container account-shell">
      <section class="card account-panel" aria-labelledby="pricing-heading">
        <p class="eyebrow">Subscription prices on record — new sales paused</p>
        <h2 id="pricing-heading">Reference pricing for the paused Research offer</h2>
        <div class="account-format-grid">
          <article class="account-format-card">
            <p class="eyebrow">Annual reference price</p>
            <h3>USD 290/year</h3>
            <p>The listed annual price was USD 290 per year. The offer is paused while included benefits are independently verified.</p>
          </article>
          <article class="account-format-card">
            <p class="eyebrow">Monthly alternative</p>
            <h3>USD 29/month</h3>
            <p>The listed monthly price was USD 29 per month. No free trial and no introductory discount. New checkout is paused.</p>
          </article>
        </div>
        <p class="account-help">Applicable taxes may be added by the merchant of record if billing applies. New subscriptions are currently paused.</p>
        <p id="research-checkout-status" class="account-status" role="status" aria-live="polite">New subscriptions are paused. This page cannot start a payment.</p>
      </section>

      <section class="card account-panel" aria-labelledby="included-heading">
        <p class="eyebrow">Free versus planned Research</p>
        <h2 id="included-heading">What is public and what is not yet verified</h2>
        <h3>Free without a Research Membership</h3>
        <ul>
          <li>Daily USD Impact news and the designated public Research sample.</li>
          <li>Some complete historical Weekly and Monthly reports already published publicly. These are not exclusive subscriber benefits.</li>
          <li>Public Weekly Score overview and methodology pages.</li>
        </ul>
        <h3>Planned Research Membership scope</h3>
        <p>None of the following five items is currently confirmed as available or included in a new paid membership. Release requires verified delivery, actual member access, and source rights.</p>
        <ul>
          <li>Current member Weekly Reports. <em>Planned — not yet confirmed as available or included.</em></li>
          <li>Ongoing member Monthly research. <em>Planned — not yet confirmed as available or included.</em></li>
          <li>Detailed Weekly Score dashboard, history and breakdowns, subject to data-licensing review. <em>Planned — not yet confirmed as available or included.</em></li>
          <li>Member methodology notes and research updates beyond public pages. <em>Planned — not yet confirmed as available or included.</em></li>
          <li>Recurring member research delivery; frequency and channel unconfirmed. <em>Planned — not yet confirmed as available or included.</em></li>
        </ul>
        <p>
          Daily USD Impact remains public. The Guided Interactive Edition, audiobook, Video Library, saved learning
          progress, and other Library Pass resources remain a separate permanent product and do not depend on a
          Research Membership subscription.
        </p>
        <p class="account-help">
          <strong>On the roadmap:</strong> Private TradingView indicator access is planned as a future Research Membership
          enhancement. It is not included at initial launch, and no availability date is promised. Access terms and any
          pricing implications will be announced separately before release.
        </p>
      </section>

      <section class="card account-panel" aria-labelledby="sample-heading">
        <p class="eyebrow">Evaluate before subscribing</p>
        <h2 id="sample-heading">A complete Weekly Report, not a teaser</h2>
        <p>
          The public sample is the complete Weekly USD Impact Brief for the week ending August 7, 2026, at least
          30 days old. It contains no private Pine source, provider access link, live member-only alert, current
          detailed score history or private download. Other complete historical reports are also available without payment.
        </p>
        <a class="button primary" href="/research/sample/">Open the public sample</a>
      </section>

      <section class="card account-panel" aria-labelledby="billing-heading">
        <p class="eyebrow">Billing and cancellation</p>
        <h2 id="billing-heading">Cancel anytime; keep access through the paid period</h2>
        <p>
          Cancellation prevents the next renewal and takes effect at the end of the current paid billing period.
          Refund handling follows the merchant of record's current policy plus mandatory consumer law; USD Impact
          does not add a separate blanket refund guarantee at launch.
        </p>
        <p>
          Canceling, refunding, suspending, or ending Research Membership never removes permanent access obtained
          through a separate Library Pass purchase.
        </p>
        <div class="button-row">
          <a class="button" href="/research/account/">Review Research account</a>
          <a class="button" href="/terms/">Terms</a>
          <a class="button" href="/refund-policy/">Refund policy</a>
        </div>
      </section>

      <section class="compliance" aria-label="Compliance note">
        <strong>Compliance note:</strong> USD Impact Research Membership is educational and informational only. It is not investment,
        financial, trading, legal, or tax advice and is not a recommendation to buy or sell any asset.
      </section>
    </div>
  </main>

  <script>
    const checkoutButtons = Array.from(document.querySelectorAll('.research-checkout-button'));
    const statusElement = document.getElementById('research-checkout-status');
    let pendingKey = '';

    const setStatus = (message, state = '') => {
      if (!(statusElement instanceof HTMLElement)) return;
      statusElement.textContent = message;
      statusElement.dataset.state = state;
    };

    const setButtonsDisabled = (disabled) => {
      for (const button of checkoutButtons) {
        if (button instanceof HTMLButtonElement) button.disabled = disabled;
      }
    };

    const checkoutKey = () => {
      if (pendingKey) return pendingKey;
      if (typeof crypto?.randomUUID !== 'function') return '';
      pendingKey = `research-${crypto.randomUUID()}`;
      return pendingKey;
    };

    const safeCheckoutUrl = (value) => {
      if (typeof value !== 'string' || !value.trim()) return '';
      try {
        const url = new URL(value);
        const hostname = url.hostname.toLowerCase();
        if (url.protocol !== 'https:' || url.username || url.password) return '';
        if (hostname !== 'lemonsqueezy.com' && !hostname.endsWith('.lemonsqueezy.com')) return '';
        return url.toString();
      } catch {
        return '';
      }
    };

    const signInHref = () => `/account/sign-in/?next=${encodeURIComponent('/research/')}`;

    for (const button of checkoutButtons) {
      button.addEventListener('click', async () => {
        if (!(button instanceof HTMLButtonElement)) return;
        const billingInterval = button.dataset.billingInterval;
        if (billingInterval !== 'monthly' && billingInterval !== 'annual') return;

        const idempotencyKey = checkoutKey();
        if (!idempotencyKey) {
          setStatus('A secure checkout request could not be created in this browser. No payment has occurred.', 'error');
          return;
        }

        setButtonsDisabled(true);
        setStatus('Verifying your account and preparing secure Lemon Squeezy checkout…', 'pending');

        try {
          const response = await fetch('/api/commerce?action=research-membership-checkout', {
            method: 'POST',
            credentials: 'same-origin',
            cache: 'no-store',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
              'Idempotency-Key': idempotencyKey,
            },
            body: JSON.stringify({ billingInterval, idempotencyKey }),
          });
          const body = await response.json().catch(() => ({}));
          if (response.status === 401 || body?.code === 'AUTHENTICATION_REQUIRED') {
            window.location.assign(signInHref());
            return;
          }
          if (!response.ok) throw new Error(body?.error || 'Research checkout could not be prepared.');
          const checkoutUrl = safeCheckoutUrl(body?.checkoutUrl);
          if (!checkoutUrl) throw new Error('The secure Research checkout URL could not be verified.');
          window.location.assign(checkoutUrl);
        } catch (error) {
          pendingKey = '';
          setStatus(
            error instanceof Error
              ? `${error.message} No payment or access change has occurred.`
              : 'Research checkout could not be prepared. No payment or access change has occurred.',
            'error',
          );
          setButtonsDisabled(false);
        }
      });
    }
  </script>
</BaseLayout>
