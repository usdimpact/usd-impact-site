---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const PUBLIC_SAMPLE_DATE = '2026-08-07';
const PUBLIC_SAMPLE_MIN_AGE_DAYS = 30;
const reports = await getCollection('weeklyReports');
const entry = reports.find((report) => report.data.status === 'published' && report.data.periodEnd === PUBLIC_SAMPLE_DATE);
if (!entry) throw new Error(`Approved Research public sample ${PUBLIC_SAMPLE_DATE} was not found.`);

const sampleEnd = Date.parse(`${PUBLIC_SAMPLE_DATE}T23:59:59Z`);
const sampleAgeDays = Math.floor((Date.now() - sampleEnd) / 86_400_000);
if (!Number.isInteger(sampleAgeDays) || sampleAgeDays < PUBLIC_SAMPLE_MIN_AGE_DAYS) {
  throw new Error('Research public sample must be at least 30 days old.');
}

const { Content } = await render(entry);
const sourceMap = new Map(entry.data.sourceEditions.map((source) => [source.date, source]));
const formatDate = (value) => new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${value}T12:00:00Z`));
const signed = (value, digits = 2) => `${value >= 0 ? '+' : ''}${value.toFixed(digits)}`.replace('-', '−');
---
<BaseLayout
  title="Research Membership sample | USD Impact"
  description="Read a complete Weekly USD Impact Brief that is at least 30 days behind current member research."
>
  <main id="main-content">
    <section class="hero reports-hero">
      <div class="container">
        <p class="eyebrow">Public Research Membership sample</p>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.summary}</p>
        <p class="edition-meta">
          Reporting period {formatDate(entry.data.periodStart)}–{formatDate(entry.data.periodEnd)} · Public sample age {sampleAgeDays}+ days
        </p>
        <div class="button-row">
          <a class="button" href="/research/">Research Membership overview</a>
          <a class="button" href="/research/account/">Research account</a>
        </div>
      </div>
    </section>

    <div class="container">
      <section class="compliance" aria-label="Public sample boundary">
        <strong>Public sample:</strong> This is a complete historical Weekly Report selected for public evaluation. It contains no
        private TradingView source or invite link, live member-only alert, current detailed score history, or private download.
      </section>

      <section class="report-score-panel report-score-detail" aria-label="Historical weekly score summary">
        <div>
          <span>USD Impact Score</span>
          <strong>{signed(entry.data.score.value)}</strong>
        </div>
        <div>
          <span>Regime</span>
          <strong>{entry.data.score.regime}</strong>
        </div>
        <div>
          <span>Weekly change</span>
          <strong>{signed(entry.data.score.weekOverWeekChange)}</strong>
        </div>
        <div>
          <span>Four-week change</span>
          <strong>{signed(entry.data.score.fourWeekChange)}</strong>
        </div>
      </section>

      <section class="report-themes">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Weekly synthesis</p>
            <h2>What shaped the week</h2>
          </div>
        </div>
        <div class="report-theme-grid">
          {entry.data.themes.map((theme) => (
            <article class="card report-theme-card">
              <h3>{theme.title}</h3>
              <p>{theme.summary}</p>
              <p class="report-theme-sources">
                Daily editions:
                {theme.editionDates.map((date, index) => {
                  const source = sourceMap.get(date);
                  return source ? (
                    <>
                      {index > 0 && ' · '}
                      <a href={source.url}>{date}</a>
                    </>
                  ) : null;
                })}
              </p>
            </article>
          ))}
        </div>
      </section>

      <article class="report-analysis">
        <Content />
      </article>

      {entry.data.catalysts.length > 0 && (
        <section class="report-catalysts">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Historical context</p>
              <h2>What this report was watching next</h2>
            </div>
          </div>
          <div class="catalyst-list">
            {entry.data.catalysts.map((catalyst) => {
              const source = sourceMap.get(catalyst.sourceEditionDate);
              return (
                <article class="card">
                  <time datetime={catalyst.date}>{formatDate(catalyst.date)}</time>
                  <h3>{catalyst.event}</h3>
                  {source && <p class="card-sources">Source: <a href={source.url}>{source.title}</a></p>}
                </article>
              );
            })}
          </div>
        </section>
      )}

      <section class="report-sources">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Provenance</p>
            <h2>Reports used</h2>
          </div>
        </div>
        <ol>
          {entry.data.sourceEditions.map((source) => (
            <li><a href={source.url}>{source.title}</a></li>
          ))}
          <li>
            <a href={entry.data.score.sourceUrl} target="_blank" rel="noreferrer">
              Archived Weekly USD Impact Score input — {entry.data.periodEnd}
            </a>
          </li>
        </ol>
      </section>

      <div class="button-row">
        <a class="button primary" href="/research/">See Research Membership</a>
        <a class="button" href="/news/">Read current public Daily USD Impact</a>
      </div>

      <section class="compliance" aria-label="Compliance note">
        <strong>Compliance note:</strong> {entry.data.complianceNote}
      </section>
    </div>
  </main>
</BaseLayout>
