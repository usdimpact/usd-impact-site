---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FrameworkEvidenceChain from '../components/FrameworkEvidenceChain.astro';

const latestWeeklyReport = (await getCollection('weeklyReports'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => b.data.periodEnd.localeCompare(a.data.periodEnd))[0];
---
<BaseLayout
  title="Weekly USD Impact Score | Dollar Regime Dashboard"
  description="The weekly USD Impact Score dashboard: a cross-asset reading of the current dollar regime, updated by the USD Impact data pipeline."
>
  <section class="hero score-hero">
    <div class="container">
      <div class="eyebrow">Weekly USD Impact Score</div>
      <h1>The dollar regime, measured weekly.</h1>
      <p class="lead">A systematic cross-asset reading produced by the USD Impact data pipeline. Use it as educational context alongside the Daily USD Impact edition and the broader framework.</p>
      <div class="button-row">
        <a class="button primary" href="#score-dashboard">View the latest score</a>
        <a class="button secondary" href="/score/methodology/">Read the full methodology</a>
        <a class="button secondary" href="https://usd-impact-pipeline.pages.dev/en/" target="_blank" rel="noreferrer">Open standalone dashboard</a>
      </div>
    </div>
  </section>

  <main class="container">
    <section class="score-intro grid">
      <article class="card">
        <div class="eyebrow">What it measures</div>
        <h2>Cross-asset dollar pressure</h2>
        <p>The score combines market inputs into one weekly regime reading rather than treating DXY as a complete measure of dollar conditions.</p>
      </article>
      <article class="card">
        <div class="eyebrow">How to use it</div>
        <h2>Context, not a signal</h2>
        <p>Read the score together with rates, liquidity, commodities, FX and risk conditions. It is descriptive, not a forecast, recommendation or trading instruction.</p>
      </article>
      <article class="card">
        <div class="eyebrow">Methodology</div>
        <h2>Formula published</h2>
        <p>The production variables, signed weights, normalization, data treatment, regime bands, source provenance and validation limitations are publicly documented.</p>
      </article>
    </section>

    <FrameworkEvidenceChain current="score" weeklyHref={latestWeeklyReport?.data.slug ?? '/reports/'} />

    <section class="score-methodology-callout card" aria-labelledby="score-methodology-heading">
      <div>
        <div class="eyebrow">Independent review</div>
        <h2 id="score-methodology-heading">Do not take the score on faith.</h2>
        <p>USD Impact Score v2 uses eight fixed-weight weekly market levels standardized against the expanding full sample since January 2015. The methodology page states exactly how a number such as −0.72 is produced, including missing-data rules, ±3.5 clipping, the lack of explicit correlation adjustment, and why the existing historical checks are descriptive rather than true out-of-sample validation.</p>
      </div>
      <a class="button report-link" href="/score/methodology/">Audit the methodology</a>
    </section>

    <section id="score-dashboard" class="score-dashboard-section">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Live dashboard</div>
          <h2>Latest USD Impact Score</h2>
        </div>
        <a href="https://usd-impact-pipeline.pages.dev/en/" target="_blank" rel="noreferrer">Open in a new tab</a>
      </div>
      <div class="score-embed-shell">
        <iframe
          class="score-embed"
          src="https://usd-impact-pipeline.pages.dev/en/"
          title="USD Impact Score weekly dashboard"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
        <p class="score-embed-fallback">If the dashboard does not load inside this page, <a href="https://usd-impact-pipeline.pages.dev/en/" target="_blank" rel="noreferrer">open the standalone version</a>.</p>
      </div>
    </section>

    {latestWeeklyReport && (
      <section class="reports-promo card">
        <div>
          <div class="eyebrow">News + score</div>
          <h2>Read the Weekly USD Impact Brief</h2>
          <p>{latestWeeklyReport.data.summary}</p>
        </div>
        <a class="button report-link" href={latestWeeklyReport.data.slug}>Open the Weekly Brief</a>
      </section>
    )}

    <section class="score-archive-section" aria-labelledby="previous-weeks-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Weekly archive</div>
          <h2 id="previous-weeks-heading">Previous weeks</h2>
        </div>
        <a href="https://usd-impact-pipeline.pages.dev/archive/en/" target="_blank" rel="noreferrer">Open the full archive</a>
      </div>
      <p class="score-archive-intro">Review the score, regime, and deterministic commentary exactly as they were published for each completed week.</p>
      <div class="score-archive-embed-shell">
        <iframe
          class="score-archive-embed"
          src="https://usd-impact-pipeline.pages.dev/archive/en/"
          title="Previous Weekly USD Impact Score editions"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
        <p class="score-embed-fallback">If the archive does not load inside this page, <a href="https://usd-impact-pipeline.pages.dev/archive/en/" target="_blank" rel="noreferrer">open the full archive</a>.</p>
      </div>
    </section>

    <section class="compliance" aria-label="Compliance note">
      <strong>Compliance note:</strong> Educational and informational only. The USD Impact Score is not investment, financial, trading, legal, or tax advice and is not a recommendation to buy or sell any asset.
    </section>
  </main>
</BaseLayout>

<style>
  .score-methodology-callout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    margin-top: 48px;
    border-left: 5px solid var(--gold);
    background: linear-gradient(135deg, #fff, #f7f3ea);
  }
  .score-methodology-callout h2 { margin: 6px 0 8px; }
  .score-methodology-callout p { max-width: 800px; margin: 0; color: var(--slate); }
  @media (max-width: 720px) {
    .score-methodology-callout { grid-template-columns: 1fr; }
  }
</style>