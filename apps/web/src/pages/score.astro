---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FrameworkEvidenceChain from '../components/FrameworkEvidenceChain.astro';
import { resolveScorePipelineOrigin, scorePipelineUrl } from '../lib/score-pipeline-origin.js';

const latestWeeklyReport = (await getCollection('weeklyReports'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => b.data.periodEnd.localeCompare(a.data.periodEnd))[0];
const scorePipelineOrigin = resolveScorePipelineOrigin(
  import.meta.env.PUBLIC_SCORE_PIPELINE_ORIGIN,
  process.env.SCORE_PREVIEW_PIPELINE_ORIGIN,
  process.env.VERCEL_ENV,
);
const vintageAuditUrl = scorePipelineUrl('/data/research/score_v2_vintage_comparison_latest.html', scorePipelineOrigin, process.env.SCORE_PREVIEW_PIPELINE_ORIGIN, process.env.VERCEL_ENV);
const dashboardUrl = scorePipelineUrl('/en/', scorePipelineOrigin, process.env.SCORE_PREVIEW_PIPELINE_ORIGIN, process.env.VERCEL_ENV);
const archiveUrl = scorePipelineUrl('/archive/en/', scorePipelineOrigin, process.env.SCORE_PREVIEW_PIPELINE_ORIGIN, process.env.VERCEL_ENV);
const scoreHandoffOrigin = scorePipelineOrigin;
---
<BaseLayout
  title="Weekly USD Impact Score | Dollar Regime Dashboard"
  description="The weekly USD Impact Score dashboard: a cross-asset reading of the current dollar regime, updated by the USD Impact data pipeline."
>
  <section class="hero score-hero">
    <div class="container">
      <div class="eyebrow">Weekly USD Impact Score</div>
      <h1>The dollar regime, measured weekly.</h1>
      <p class="lead">A systematic cross-asset reading produced by the USD Impact data pipeline. Use it as educational context alongside the Daily USD Impact edition and the broader framework.</p>
      <div class="button-row">
        <a class="button primary" href="#score-dashboard">View the latest score</a>
        <a class="button secondary" href="/score/methodology/">Read the full methodology</a>
        <a class="button secondary" href={vintageAuditUrl} target="_blank" rel="noreferrer">Audit historical revisions</a>
        <button class="button secondary" type="button" data-score-handoff data-score-path="/en/" data-score-target="_self">Open standalone dashboard securely</button>
      </div>
    </div>
  </section>

  <main class="container">
    <section class="score-intro grid">
      <article class="card">
        <div class="eyebrow">What it measures</div>
        <h2>Cross-asset dollar pressure</h2>
        <p>The score combines market inputs into one weekly regime reading rather than treating DXY as a complete measure of dollar conditions.</p>
      </article>
      <article class="card">
        <div class="eyebrow">How to use it</div>
        <h2>Context, not a signal</h2>
        <p>Read the score together with rates, liquidity, commodities, FX and risk conditions. It is descriptive, not a forecast, recommendation or trading instruction.</p>
      </article>
      <article class="card">
        <div class="eyebrow">Methodology</div>
        <h2>Formula published</h2>
        <p>The production variables, signed weights, normalization, data treatment, regime bands, source provenance and validation limitations are publicly documented.</p>
      </article>
    </section>

    <FrameworkEvidenceChain current="score" weeklyHref={latestWeeklyReport?.data.slug ?? '/reports/'} />

    <section class="score-methodology-callout card" aria-labelledby="score-methodology-heading">
      <div>
        <div class="eyebrow">Independent review</div>
        <h2 id="score-methodology-heading">Do not take the score on faith.</h2>
        <p>USD Impact Score v2 uses eight fixed-weight weekly market levels standardized against the expanding full sample since January 2015. The methodology page states exactly how a number such as −0.72 is produced, including missing-data rules, ±3.5 clipping, the lack of explicit correlation adjustment, and why the existing historical checks are descriptive rather than true out-of-sample validation. The separate vintage audit shows how valid as-published readings compare with the same weeks in the current recalculated history.</p>
      </div>
      <div class="button-row">
        <a class="button report-link" href="/score/methodology/">Audit the methodology</a>
        <a class="button report-link" href={vintageAuditUrl} target="_blank" rel="noreferrer">Compare published vintages</a>
      </div>
    </section>

    <section id="score-dashboard" class="score-dashboard-section">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Live dashboard</div>
          <h2>Latest USD Impact Score</h2>
        </div>
        <button type="button" data-score-handoff data-score-path="/en/" data-score-target="_self">Verify membership and open standalone dashboard</button>
      </div>
      <p class="score-embed-fallback">Protected Score content opens in a standalone page after verifying your Research Membership. Embedded third-party cookies are not used.</p>
    </section>

    {latestWeeklyReport && (
      <section class="reports-promo card">
        <div>
          <div class="eyebrow">News + score</div>
          <h2>Read the Weekly USD Impact Brief</h2>
          <p>{latestWeeklyReport.data.summary}</p>
        </div>
        <a class="button report-link" href={latestWeeklyReport.data.slug}>Open the Weekly Brief</a>
      </section>
    )}

    <section class="score-archive-section" aria-labelledby="previous-weeks-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Weekly archive</div>
          <h2 id="previous-weeks-heading">Previous weeks</h2>
        </div>
        <button type="button" data-score-handoff data-score-path="/archive/en/" data-score-target="_self">Open the full archive securely</button>
      </div>
      <p class="score-archive-intro">Review the score, regime, and deterministic commentary exactly as they were published for each completed week.</p>
      <p class="score-embed-fallback">Use the button above to open the member archive securely in this tab.</p>
    </section>

    <p id="score-handoff-status" role="status" aria-live="polite">The protected dashboard requires an active Research Membership. Select a secure access button to verify membership.</p>
    <a id="score-sign-in-help" href="/account/sign-in/?next=%2Fscore%2F" hidden>Sign in to access Score</a>
    <form id="score-handoff-form" method="POST" action={`${scoreHandoffOrigin}/score-redeem`} target="_self" referrerpolicy="no-referrer" hidden>
      <input type="hidden" name="ticket" value="" autocomplete="off" />
    </form>

    <section class="compliance" aria-label="Compliance note">
      <strong>Compliance note:</strong> Educational and informational only. The USD Impact Score is not investment, financial, trading, legal, or tax advice and is not a recommendation to buy or sell any asset.
    </section>
  </main>
</BaseLayout>

<script>
  import { requestScoreHandoff } from '../lib/score-handoff-browser.js';
  const controls = [...document.querySelectorAll('[data-score-handoff]')];
  const form = document.getElementById('score-handoff-form');
  const ticketField = form?.querySelector('input[name="ticket"]');
  const status = document.getElementById('score-handoff-status');
  const signIn = document.getElementById('score-sign-in-help');
  let busy = false;
  for (const control of controls) {
    control.addEventListener('click', async () => {
      if (busy || !(form instanceof HTMLFormElement) || !(ticketField instanceof HTMLInputElement)) return;
      busy = true;
      controls.forEach((button) => { button.disabled = true; });
      ticketField.value = '';
      if (signIn) signIn.hidden = true;
      if (status) status.textContent = 'Checking your Research Membership…';
      try {
        const path = control.getAttribute('data-score-path');
        const target = control.getAttribute('data-score-target');
        const result = await requestScoreHandoff(path);
        if (!result.ok) {
          if (status) status.textContent = result.code === 'AUTHENTICATION_REQUIRED'
            ? 'Please sign in to USD Impact, then return to this page.'
            : result.code === 'RESEARCH_MEMBERSHIP_REQUIRED'
              ? 'An active Research Membership is required for the protected dashboard.'
              : 'Secure Score access is temporarily unavailable. No content was unlocked.';
          if (signIn) signIn.hidden = result.code !== 'AUTHENTICATION_REQUIRED';
          return;
        }
        if (target !== '_self') {
          if (status) status.textContent = 'Invalid Score destination.';
          return;
        }
        ticketField.value = result.ticket;
        form.target = target;
        if (status) status.textContent = 'Membership verified; opening protected Score content…';
        form.submit();
      } finally {
        busy = false;
        controls.forEach((button) => { button.disabled = false; });
      }
    });
  }
</script>

<style>
  .score-methodology-callout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    margin-top: 48px;
    border-left: 5px solid var(--gold);
    background: linear-gradient(135deg, #fff, #f7f3ea);
  }
  .score-methodology-callout h2 { margin: 6px 0 8px; }
  .score-methodology-callout p { max-width: 800px; margin: 0; color: var(--slate); }
  @media (max-width: 720px) {
    .score-methodology-callout { grid-template-columns: 1fr; }
  }
</style>
