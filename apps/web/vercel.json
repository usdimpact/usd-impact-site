{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run validate && npm run build",
  "installCommand": "npm install --no-audit --no-fund",
  "outputDirectory": "dist",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/guided-edition/audiobook",
      "destination": "/api/guided-edition?__audiobook=1"
    },
    {
      "source": "/guided-edition/audiobook/:path*",
      "destination": "/api/guided-edition?__audiobook=1&__audio_path=:path*"
    },
    {
      "source": "/guided-edition/video-library",
      "destination": "/api/guided-edition?__video_library=1"
    },
    {
      "source": "/guided-edition/video-library/:path*",
      "destination": "/api/guided-edition?__video_library=1&__video_path=:path*"
    },
    {
      "source": "/guided-edition",
      "destination": "/api/guided-edition"
    },
    {
      "source": "/guided-edition/:path*",
      "destination": "/api/guided-edition?__paid_path=:path*"
    },
    {
      "source": "/unsubscribe",
      "destination": "/api/waitlist?action=unsubscribe"
    },
    {
      "source": "/api/commerce-readiness",
      "destination": "/api/account?action=commerce-readiness"
    },
    {
      "source": "/api/auth-login",
      "destination": "/api/account?action=login"
    },
    {
      "source": "/api/auth-confirm",
      "destination": "/api/account?action=confirm"
    },
    {
      "source": "/api/auth-refresh",
      "destination": "/api/account?action=refresh"
    },
    {
      "source": "/api/auth-logout",
      "destination": "/api/account?action=logout"
    },
    {
      "source": "/api/account-access",
      "destination": "/api/account?action=access"
    },
    {
      "source": "/api/account-support",
      "destination": "/api/account?action=support"
    },
    {
      "source": "/api/account-export",
      "destination": "/api/account?action=export"
    },
    {
      "source": "/api/account-delete",
      "destination": "/api/account?action=delete"
    },
    {
      "source": "/api/account-deletion-finalizer",
      "destination": "/api/account?action=deletion-finalizer"
    },
    {
      "source": "/api/video-progress",
      "destination": "/api/account?action=video-progress"
    },
    {
      "source": "/api/resend-webhook",
      "destination": "/api/waitlist?action=resend-webhook"
    },
    {
      "source": "/api/telemetry-report",
      "destination": "/api/telemetry?action=report"
    },
    {
      "source": "/api/checklist-analytics",
      "destination": "/api/telemetry?action=checklist-report"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/internal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/unsubscribe",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/commerce-readiness",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
